{
  "info": {
    "name": "Verteco SmartJob \u2014 Person 1 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Manager-side baseline routes. Technician HTTP and upload/sync routes are owned by Person 4. Use the development API key only in a local environment."
  },
  "item": [
    {
      "name": "Dashboard stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-SmartJob-Key",
            "value": "{{managerKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/dashboard/stats"
      }
    },
    {
      "name": "List jobs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-SmartJob-Key",
            "value": "{{managerKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs?page=1&pageSize=20&sort=-scheduledDate"
      }
    },
    {
      "name": "Get job",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-SmartJob-Key",
            "value": "{{managerKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      }
    },
    {
      "name": "Create job with standard checklist",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-SmartJob-Key",
            "value": "{{managerKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"siteId\": \"{{siteId}}\",\n  \"technicianId\": \"{{technicianId}}\",\n  \"priority\": \"Medium\",\n  \"scheduledDate\": \"2026-10-01\",\n  \"notes\": \"Inspect equipment\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }

@model ProfileViewModel
@{
    ViewData["Title"] = "Profile & Settings";
}

<div class="page-head">
  <div>
    <div class="page-title">Profile &amp; Settings</div>
    <div class="page-desc">Manage your account details and sign-in email.</div>
  </div>
</div>

<div class="card section-card" style="max-width:600px;">
  <div class="section-card-head"><h3>Account details</h3></div>
  <div class="section-card-body pad">
    @if (TempData["ProfileSaved"] is string message)
    {
      <p role="status" style="color:var(--success);">@message</p>
    }
    <form asp-controller="Profile" asp-action="Index" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="All" class="form-error"></div>
      <div class="field">
        <label asp-for="FullName">Full name</label>
        <input asp-for="FullName" autocomplete="name" />
        <span asp-validation-for="FullName" class="field-error"></span>
      </div>
      <div class="field">
        <label asp-for="Email">Sign-in email</label>
        <input asp-for="Email" type="email" autocomplete="email" />
        <span asp-validation-for="Email" class="field-error"></span>
      </div>
      <div class="field">
        <label asp-for="Phone">Phone</label>
        <input asp-for="Phone" type="tel" autocomplete="tel" />
        <span asp-validation-for="Phone" class="field-error"></span>
      </div>
      <div class="field">
        <label asp-for="CurrentPassword">Current password</label>
        <input asp-for="CurrentPassword" type="password" autocomplete="current-password" />
        <span class="muted">Required only when changing your sign-in email.</span>
      </div>
      <div class="info-row"><span>Role</span><span class="pill">@Model.Role</span></div>
      <button type="submit" class="btn btn-primary" style="margin-top:18px;">Save changes</button>
    </form>
  </div>
</div>

<div class="card section-card" style="max-width:600px;margin-top:16px;">
  <div class="section-card-head"><h3>Password &amp; security</h3></div>
  <div class="section-card-body pad">
    <p class="muted">Need a new password? Request a reset link at your sign-in email.</p>
    <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="ForgotPassword">Reset password</a>
  </div>
</div>

<div class="card card-pad" style="max-width:600px;margin-top:16px;">
  <form asp-controller="Account" asp-action="Logout" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger btn-sm">Log out</button>
  </form>
</div>

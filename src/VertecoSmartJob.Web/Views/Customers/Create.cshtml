@model CustomerFormViewModel
@{
    ViewData["Title"] = "New Customer";
}

<div class="page-head"><div><div class="page-title">New Customer</div></div></div>

<div class="card card-pad" style="max-width:600px;">
    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="form-error"></div>
        <div class="form-grid">
            <div class="field full"><label>Name</label><input asp-for="Name" type="text" /><span asp-validation-for="Name" class="field-error"></span></div>
            <div class="field"><label>Industry</label><input asp-for="Industry" type="text" /></div>
            <div class="field"><label>Contact name</label><input asp-for="ContactName" type="text" /></div>
            <div class="field"><label>Contact email</label><input asp-for="ContactEmail" type="email" /><span asp-validation-for="ContactEmail" class="field-error"></span></div>
            <div class="field"><label>Contact phone</label><input asp-for="ContactPhone" type="text" /></div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create customer</button>
            <a class="btn btn-ghost" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
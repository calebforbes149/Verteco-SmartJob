@model List<CustomerDto>
@{
    ViewData["Title"] = "Customers";
}

<div class="page-head">
  <div>
    <div class="page-title">Customers</div>
    <div class="page-desc">Every client, with their sites at a glance.</div>
  </div>
  @if (User.IsInRole("Manager"))
  {
      <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create">+ New customer</a>
      </div>
  }
</div>

<form method="get" class="filter-bar">
  <div class="search-wrap">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.6" y2="16.6"/></svg>
    <input type="text" name="q" value="@ViewData["Q"]" placeholder="Customer name…" />
  </div>
  <button type="submit" class="btn btn-sm">Filter</button>
</form>

<div class="card">
  @if (Model.Count == 0)
  {
      <div class="empty-state"><b>No customers match that search</b></div>
  }
  else
  {
      <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Industry</th><th>Contact</th><th>Sites</th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
          <tr class="clickable" onclick="location.href='@Url.Action("Details", new { id = c.Id })'">
            <td><div class="cell-primary">@c.Name</div></td>
            <td>@c.Industry</td>
            <td><div class="cell-primary">@c.ContactName</div><div class="cell-sub">@c.ContactEmail</div></td>
            <td class="mono">@c.Sites.Count</td>
          </tr>
        }
        </tbody>
      </table>
      </div>
  }
</div>
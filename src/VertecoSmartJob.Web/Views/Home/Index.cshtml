@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var forbiddenMessage = ViewBag.ForbiddenMessage as string;
    var firstName = User.Identity?.Name?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
    var today = DateTime.UtcNow.AddHours(2);
}

<div class="page-head">
  <div>
    <div class="page-title">Good day, @firstName</div>
    <div class="page-desc">Here's what's happening across your field teams today, @today.ToString("d MMMM yyyy").</div>
  </div>
  @if (User.IsInRole("Manager"))
  {
    <div class="page-actions"><a class="btn btn-primary" asp-controller="JobCards" asp-action="Create">New job card</a></div>
  }
</div>

@if (forbiddenMessage is not null)
{
  <div class="card card-pad" role="status">
    <h2>Manager dashboard</h2>
    <p class="page-desc">@forbiddenMessage</p>
  </div>
}
else
{
  <div class="kpi-row dashboard-kpis">
    <div class="card kpi-card">
      <span class="kpi-ico dashboard-icon dashboard-icon-red" aria-hidden="true">▣</span>
      <div class="kpi-val">@Model.Stats.ActiveJobCards</div>
      <div class="kpi-label">Active job cards</div>
    </div>
    <div class="card kpi-card">
      <span class="kpi-ico dashboard-icon dashboard-icon-blue" aria-hidden="true">▤</span>
      <div class="kpi-val">@Model.Stats.DueTodayCount</div>
      <div class="kpi-label">Due today</div>
    </div>
    <div class="card kpi-card">
      <span class="kpi-ico dashboard-icon dashboard-icon-rose" aria-hidden="true">⚑</span>
      <div class="kpi-val">@Model.Stats.FlaggedJobCards</div>
      <div class="kpi-label">Flagged — needs review</div>
    </div>
    <div class="card kpi-card">
      <span class="kpi-ico dashboard-icon dashboard-icon-green" aria-hidden="true">♟</span>
      <div class="kpi-val">@Model.Stats.TechniciansAvailable</div>
      <div class="kpi-label">Technicians available now</div>
    </div>
  </div>

  <div class="two-col dashboard-main">
    <section class="card section-card">
      <div class="section-card-head">
        <h2>Recently scheduled job cards</h2>
        <a asp-controller="JobCards" asp-action="Index">View all job cards</a>
      </div>
      @if (Model.RecentJobs.Count == 0)
      {
        <div class="empty-state">
          <b>No job cards yet</b>
          <p>Create a customer and site, then add your first job card.</p>
          <a class="btn btn-primary" asp-controller="Customers" asp-action="Create">Add a customer</a>
        </div>
      }
      else
      {
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Job #</th><th scope="col">Customer / Site</th><th scope="col">Technician</th><th scope="col">Priority</th><th scope="col">Status</th></tr></thead>
            <tbody>
              @foreach (var job in Model.RecentJobs)
              {
                <tr>
                  <td class="mono"><a asp-controller="JobCards" asp-action="Details" asp-route-id="@job.Id">@job.Number</a></td>
                  <td><div class="cell-primary">@job.CustomerName</div><div class="cell-sub">@job.SiteName</div></td>
                  <td>@(job.TechnicianName ?? "Needs technician")</td>
                  <td><span class="pill pill-@job.Priority.ToLowerInvariant()">@job.Priority</span></td>
                  <td>
                    <span class="pill pill-@job.Status.ToLowerInvariant()">@job.Status</span>
                    @if (job.IsFlagged) { <span class="flag-badge" title="@job.FlagReason">⚑ Flagged</span> }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </section>

    <section class="card section-card">
      <div class="section-card-head"><h2>Quick actions</h2></div>
      <div class="dashboard-actions">
        <a class="dashboard-action" asp-controller="JobCards" asp-action="Create">Create a job card</a>
        <a class="dashboard-action" asp-controller="Customers" asp-action="Index">Manage customers</a>
        <a class="dashboard-action" asp-controller="StatusTracking" asp-action="Index">Status tracking board</a>
        <a class="dashboard-action" asp-controller="FlaggedItems" asp-action="Index">Review flagged items</a>
      </div>
    </section>
  </div>
}

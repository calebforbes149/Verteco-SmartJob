@model List<TechnicianDto>
@{
    ViewData["Title"] = "Technicians";
}

<div class="page-head">
  <div>
    <div class="page-title">Technicians</div>
    <div class="page-desc">Every technician on the roster, with their current availability and skills.</div>
  </div>
  @if (User.IsInRole("Manager"))
  {
      <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create">+ New technician</a>
      </div>
  }
</div>

<form method="get" class="filter-bar">
  <div class="search-wrap">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.6" y2="16.6"/></svg>
    <input type="text" name="q" value="@ViewData["Q"]" placeholder="Technician name…" />
  </div>
  <button type="submit" class="btn btn-sm">Filter</button>
</form>

<div class="card">
  @if (Model.Count == 0)
  {
      <div class="empty-state"><b>No technicians match that search</b></div>
  }
  else
  {
      <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Skills</th><th>Availability</th><th>Jobs completed</th></tr></thead>
        <tbody>
        @foreach (var t in Model)
        {
          <tr class="clickable" onclick="location.href='@Url.Action("Details", new { id = t.Id })'">
            <td><div class="cell-primary">@t.FullName</div><div class="cell-sub">@t.Email</div></td>
            <td>@string.Join(", ", t.Skills)</td>
            <td><span class="pill">@t.Availability</span></td>
            <td class="mono">@t.JobsCompleted</td>
          </tr>
        }
        </tbody>
      </table>
      </div>
  }
</div>
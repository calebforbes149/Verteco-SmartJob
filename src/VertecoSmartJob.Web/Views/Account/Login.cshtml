@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in · SmartJob</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <div class="login-shell">
        <div class="login-brand">
            <div class="login-brand-content">
                <div class="brand-plate">
                    <img src="~/images/verteco-logo-full.png" alt="Verteco - The Power of Innovation">
                </div>
                <div class="brand-caption">SmartJob · Manager Console</div>
                <div class="login-headline">Job cards for teams who keep <span>power &amp; infrastructure</span> running.</div>
                <p class="login-sub">Schedule work, assign technicians, and track every job card from first site visit to client sign-off.</p>
            </div>
            <div class="login-foot">© 2026 Verteco (Pty) Ltd · SmartJob</div>
        </div>
        <div class="login-form-side">
            <div class="login-form">
                <img src="~/images/verteco-mark-transparent.png" alt="Verteco" class="login-form-mark">
                <h2>Sign in to SmartJob</h2>
                <span class="muted">Enter your SmartJob email and password to continue.</span>

                @if (TempData["PasswordResetSuccess"] is string resetMessage)
                {
                    <p role="status" style="color:var(--success);margin-top:16px;">@resetMessage</p>
                }

                @if (Model.RetryAfterSeconds is > 0)
                {
                    <div class="login-wait" role="alert">
                        <strong>@(Model.IsAccountLocked ? "Account temporarily locked" : "Too many sign-in requests")</strong>
                        <span id="login-wait-message">Please try again in <span id="login-countdown" data-seconds="@Model.RetryAfterSeconds">@TimeSpan.FromSeconds(Model.RetryAfterSeconds.Value).ToString(@"mm\:ss")</span>.</span>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="All" class="form-error"></div>

                    <div class="field">
                        <label>Work email</label>
                        <input asp-for="Email" type="text" autocomplete="username" />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label>Password</label>
                        <input asp-for="Password" type="password" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <button class="btn btn-primary login-submit" type="submit">Sign in →</button>
                </form>
                <p style="margin-top:16px;"><a asp-controller="Account" asp-action="ForgotPassword">Forgot your password?</a></p>
            </div>
        </div>
    </div>
    <script>
        const countdown = document.getElementById('login-countdown');
        if (countdown) {
            const submit = document.querySelector('.login-submit');
            const message = document.getElementById('login-wait-message');
            const end = Date.now() + Number(countdown.dataset.seconds) * 1000;
            submit.disabled = true;
            const tick = () => {
                const remaining = Math.max(0, Math.ceil((end - Date.now()) / 1000));
                if (remaining === 0) {
                    message.textContent = 'You can try signing in now.';
                    submit.disabled = false;
                    clearInterval(timer);
                } else {
                    countdown.textContent = `${Math.floor(remaining / 60)}:${String(remaining % 60).padStart(2, '0')}`;
                }
            };
            const timer = setInterval(tick, 1000);
            tick();
        }
    </script>
</body>
</html>

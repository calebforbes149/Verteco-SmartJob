@model ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot password · SmartJob</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <div class="login-shell">
        <div class="login-brand">
            <div class="login-brand-content">
                <div class="brand-plate"><img src="~/images/verteco-logo-full.png" alt="Verteco - The Power of Innovation"></div>
                <div class="brand-caption">SmartJob · Manager Console</div>
                <div class="login-headline">Get back to <span>your field teams.</span></div>
                <p class="login-sub">Use your SmartJob work email to request a password reset link.</p>
            </div>
            <div class="login-foot">© 2026 Verteco (Pty) Ltd · SmartJob</div>
        </div>
        <div class="login-form-side">
            <div class="login-form">
                <img src="~/images/verteco-mark-transparent.png" alt="Verteco" class="login-form-mark">
                <h2>Forgot your password?</h2>
                @if (Model.IsSubmitted)
                {
                    <p role="status">If that email is registered, a reset link has been sent. Check your inbox and spam folder.</p>
                }
                else
                {
                    <p class="muted">Enter your work email. The reset link will expire after one hour.</p>
                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="form-error"></div>
                        <div class="field">
                            <label asp-for="Email">Work email</label>
                            <input asp-for="Email" type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                        <button class="btn btn-primary login-submit" type="submit">Send reset link</button>
                    </form>
                }
                <p style="margin-top:18px;"><a asp-controller="Account" asp-action="Login">Back to sign in</a></p>
            </div>
        </div>
    </div>
</body>
</html>

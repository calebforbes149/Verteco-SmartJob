@model ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Reset password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset password · SmartJob</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <div class="login-shell">
        <div class="login-brand">
            <div class="login-brand-content">
                <div class="brand-plate"><img src="~/images/verteco-logo-full.png" alt="Verteco - The Power of Innovation"></div>
                <div class="brand-caption">SmartJob · Manager Console</div>
                <div class="login-headline">Secure your <span>SmartJob account.</span></div>
                <p class="login-sub">Choose a new password for your manager account.</p>
            </div>
            <div class="login-foot">© 2026 Verteco (Pty) Ltd · SmartJob</div>
        </div>
        <div class="login-form-side">
            <div class="login-form">
                <img src="~/images/verteco-mark-transparent.png" alt="Verteco" class="login-form-mark">
                <h2>Reset your password</h2>
                <p class="muted">Use at least eight characters.</p>
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Token" type="hidden" />
                    <div asp-validation-summary="All" class="form-error"></div>
                    <div class="field">
                        <label asp-for="NewPassword">New password</label>
                        <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmPassword">Confirm new password</label>
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                    <button class="btn btn-primary login-submit" type="submit">Set new password</button>
                </form>
                <p style="margin-top:18px;"><a asp-controller="Account" asp-action="Login">Back to sign in</a></p>
            </div>
        </div>
    </div>
</body>
</html>

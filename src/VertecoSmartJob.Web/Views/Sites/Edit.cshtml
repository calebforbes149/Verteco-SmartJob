@model SiteFormViewModel
@{
    ViewData["Title"] = "Edit Site";
}

<div class="page-head"><div><div class="breadcrumb"><a asp-action="Index">Sites</a> / Edit</div><div class="page-title">Edit Site</div></div></div>

<div class="card card-pad" style="max-width:600px;">
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
  @Html.AntiForgeryToken()
  <div asp-validation-summary="All" class="form-error"></div>
  <div class="form-grid">
    <div class="field full">
      <label>Customer <span class="prototype-tag">Can't be changed here</span></label>
      <select disabled>
        @foreach (var c in Model.Customers)
        {
            <option selected="@(Model.CustomerId == c.Id)">@c.Name</option>
        }
      </select>
    </div>
    <div class="field full"><label>Name</label><input asp-for="Name" type="text" /><span asp-validation-for="Name" class="field-error"></span></div>
    <div class="field full"><label>Address</label><input asp-for="Address" type="text" /><span asp-validation-for="Address" class="field-error"></span></div>
    <div class="field"><label>Site type</label><input asp-for="SiteType" type="text" /></div>
  </div>
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
  </div>
</form>
</div>
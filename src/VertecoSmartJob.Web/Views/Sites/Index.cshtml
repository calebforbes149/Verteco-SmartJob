@model List<SiteDto>
@{
    ViewData["Title"] = "Sites";
}

<div class="page-head">
  <div>
    <div class="page-title">Sites</div>
    <div class="page-desc">Every site across every customer.</div>
  </div>
  @if (User.IsInRole("Manager"))
  {
      <div class="page-actions">
        <a class="btn btn-primary" asp-action="Create">+ New site</a>
      </div>
  }
</div>

<form method="get" class="filter-bar">
  <div class="search-wrap">
    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.6" y2="16.6"/></svg>
    <input type="text" name="q" value="@ViewData["Q"]" placeholder="Site name…" />
  </div>
  <button type="submit" class="btn btn-sm">Filter</button>
</form>

<div class="card">
  @if (Model.Count == 0)
  {
      <div class="empty-state"><b>No sites match that search</b></div>
  }
  else
  {
      <div class="table-wrap">
      <table>
        <thead><tr><th>Site</th><th>Customer</th><th>Type</th><th>Equipment</th></tr></thead>
        <tbody>
        @foreach (var s in Model)
        {
          <tr class="clickable" onclick="location.href='@Url.Action("Details", new { id = s.Id })'">
            <td><div class="cell-primary">@s.Name</div><div class="cell-sub">@s.Address</div></td>
            <td>@s.CustomerName</td>
            <td>@s.SiteType</td>
            <td class="mono">@s.Equipment.Count</td>
          </tr>
        }
        </tbody>
      </table>
      </div>
  }
</div>
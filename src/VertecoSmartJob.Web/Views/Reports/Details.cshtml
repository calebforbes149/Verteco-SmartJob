@model ReportDto
@{
    ViewData["Title"] = $"Report {Model.Id}";
}

<div class="page-head">
  <div>
    <div class="breadcrumb"><a asp-action="Index">Reports</a> / @Model.Id</div>
    <div class="page-title mono">@Model.Id</div>
    <div class="page-desc">@Model.FromUtc.ToString("dd MMM yyyy") – @Model.ToUtc.ToString("dd MMM yyyy")</div>
  </div>
  <div class="page-actions">
    <a class="btn btn-sm" asp-action="Export" asp-route-id="@Model.Id" asp-route-format="csv">⬇ Export CSV</a>
    <a class="btn btn-sm" asp-action="Export" asp-route-id="@Model.Id" asp-route-format="pdf">⬇ Export PDF</a>
  </div>
</div>

<div class="two-col">
  <div>
    <div class="card section-card">
      <div class="section-card-head"><h3>Statistics</h3></div>
      <div class="section-card-body pad">
        <div class="info-row"><span>Jobs created</span><span class="mono">@Model.JobsCreated</span></div>
        <div class="info-row"><span>Jobs completed</span><span class="mono">@Model.JobsCompleted</span></div>
        <div class="info-row"><span>Average completion time</span><span class="mono">@(Model.AverageCompletionHours?.ToString("0.0") ?? "N/A") hrs</span></div>
        <div class="info-row"><span>Jobs in this report</span><span class="mono">@Model.JobsInScope</span></div>
        <div class="info-row"><span>Currently flagged</span><span class="mono">@Model.FlaggedJobs</span></div>
        <div class="info-row"><span>High or urgent priority</span><span class="mono">@Model.HighPriorityJobs</span></div>
      </div>
    </div>

    <div class="card section-card">
      <div class="section-card-head"><h3>Status breakdown</h3></div>
      <div class="section-card-body pad">
        @foreach (var kv in Model.StatusCounts.OrderBy(kv => kv.Key))
        {
            <div class="info-row"><span>@kv.Key</span><span class="mono">@kv.Value</span></div>
        }
      </div>
    </div>
  </div>

  <div>
    <div class="card section-card">
      <div class="section-card-head"><h3>Gemini AI report analysis</h3></div>
      <div class="section-card-body pad">
        @if (string.IsNullOrWhiteSpace(Model.AiCommentary))
        {
            <p class="tiny muted">
              @switch (Model.AiStatus)
              {
                  case "NotConfigured":
                      <text>Gemini is not configured on the API server. Add the API key to enable AI analysis.</text>
                      break;
                  case "RateLimited":
                      <text>Gemini is rate limited. Please try the report again later. Report statistics and downloads still work.</text>
                      break;
                  default:
                      <text>Gemini analysis is temporarily unavailable. Check the API log for the provider status.</text>
                      break;
              }
            </p>
        }
        else
        {
            @if (Model.AiStatus == "LocalInsights")
            {
                <p class="tiny muted">Generated locally from report statistics. No external AI request was made.</p>
            }
            else
            {
                <p class="tiny muted">Generated by Gemini AI. Verify recommendations against job records.</p>
            }
            <div class="report-analysis">
              @foreach (var analysisSection in VertecoSmartJob.Contracts.Reports.ReportAnalysisFormatter.Parse(Model.AiCommentary))
              {
                  <section class="report-analysis-section">
                    <h4>@analysisSection.Heading</h4>
                    <p>@analysisSection.Body</p>
                  </section>
              }
            </div>
        }
      </div>
    </div>
  </div>
</div>

<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.CommentsFlagPage"
    BackgroundColor="#0A0C0F"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,22,24,0"
            Spacing="0">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <!-- BACK -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#111419"
                    Stroke="#272B31"
                    StrokeThickness="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="BackButton_Clicked" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="‹"
                        TextColor="#B8BCC2"
                        FontSize="30"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-3,0,0"
                        SemanticProperties.Description="Go back" />

                </Border>

                <!-- BRAND -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="VERTECO"
                        TextColor="#F2F2F2"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2.2" />

                    <HorizontalStackLayout Spacing="4">

                        <Label
                            Text="SMART"
                            TextColor="#FFFFFF"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="JOB"
                            TextColor="#ED3B3B"
                            FontSize="20"
                            FontAttributes="Bold" />

                    </HorizontalStackLayout>

                    <Label
                        Text="TECHNICIAN CONSOLE"
                        TextColor="#686E76"
                        FontSize="7"
                        FontAttributes="Bold"
                        CharacterSpacing="1.6" />

                </VerticalStackLayout>

            </Grid>

            <BoxView
                HeightRequest="1"
                Color="#24282E"
                Margin="0,20,0,0" />

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="24,26,24,32"
                Spacing="0">

                <!-- PAGE INTRO -->
                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="FIELD WORKFLOW"
                        TextColor="#ED3B3B"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2" />

                    <Label
                        Text="Comments &amp; Flag"
                        TextColor="#FFFFFF"
                        FontSize="30"
                        FontAttributes="Bold"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="Record job observations or report an issue requiring attention."
                        TextColor="#7C828A"
                        FontSize="12"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- CURRENT JOB -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="0"
                    Margin="0,24,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="0">

                        <BoxView
                            HeightRequest="2"
                            Color="#ED3B3B" />

                        <VerticalStackLayout
                            Padding="18"
                            Spacing="0">

                            <Label
                                Text="CURRENT JOB"
                                TextColor="#646A72"
                                FontSize="8"
                                FontAttributes="Bold"
                                CharacterSpacing="1.4" />

                            <Label
                                Text="{Binding JobTitle}"
                                TextColor="#FFFFFF"
                                FontSize="19"
                                FontAttributes="Bold"
                                Margin="0,8,0,0"
                                LineBreakMode="WordWrap" />

                            <Label
                                Text="{Binding JobLocation}"
                                TextColor="#7C828A"
                                FontSize="11"
                                Margin="0,5,0,0"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- TECHNICIAN COMMENTS -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,28,0,12">

                    <Label
                        Text="TECHNICIAN COMMENTS"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5" />

                    <Label
                        Text="Add observations or additional information about the work."
                        TextColor="#646A72"
                        FontSize="10"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Editor
                        Text="{Binding Comments}"
                        Placeholder="Enter comments about the job..."
                        PlaceholderColor="#5F656D"
                        TextColor="#E4E5E7"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120"
                        FontSize="12"
                        SemanticProperties.Description="Technician job comments" />

                </Border>


                <!-- ================================================= -->
                <!-- FLAG SECTION -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,28,0,12">

                    <Label
                        Text="ISSUE REPORTING"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5" />

                    <Label
                        Text="Escalate an issue to a Manager when further attention is required."
                        TextColor="#646A72"
                        FontSize="10"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>


                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">

                        <!-- FLAG TOGGLE -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="14">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4"
                                VerticalOptions="Center">

                                <Label
                                    Text="FLAG THIS JOB"
                                    TextColor="#E4E5E7"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CharacterSpacing="0.5" />

                                <Label
                                    Text="Send this issue for Manager attention."
                                    TextColor="#6F757D"
                                    FontSize="10"
                                    LineBreakMode="WordWrap" />

                            </VerticalStackLayout>

                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding IsFlagged}"
                                IsEnabled="{Binding CanChangeFlag}"
                                OnColor="#ED3B3B"
                                VerticalOptions="Center"
                                MinimumWidthRequest="44"
                                MinimumHeightRequest="44"
                                SemanticProperties.Description="Flag this job for Manager attention" />

                        </Grid>


                        <!-- FLAG DETAILS -->
                        <VerticalStackLayout
                            IsVisible="{Binding IsFlagged}"
                            IsEnabled="{Binding CanChangeFlag}"
                            Spacing="0">

                            <BoxView
                                HeightRequest="1"
                                Color="#292D33"
                                Margin="0,2,0,18" />


                            <!-- FLAG REASON -->
                            <Label
                                Text="FLAG REASON *"
                                TextColor="#8D939A"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.8" />

                            <Border
                                BackgroundColor="#171A1F"
                                Stroke="#30343A"
                                StrokeThickness="1"
                                Padding="5"
                                Margin="0,7,0,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <Picker
                                    Title="Select a reason"
                                    ItemsSource="{Binding FlagReasons}"
                                    SelectedItem="{Binding SelectedFlagReason}"
                                    TextColor="#E4E5E7"
                                    TitleColor="#5F656D"
                                    BackgroundColor="Transparent"
                                    MinimumHeightRequest="48"
                                    SemanticProperties.Description="Reason for flagging the job" />

                            </Border>


                            <!-- ISSUE DETAILS -->
                            <Label
                                Text="ISSUE DETAILS *"
                                TextColor="#8D939A"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.8"
                                Margin="0,18,0,0" />

                            <Border
                                BackgroundColor="#171A1F"
                                Stroke="#30343A"
                                StrokeThickness="1"
                                Padding="14"
                                Margin="0,7,0,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <Editor
                                    Text="{Binding FlagDetails}"
                                    Placeholder="Describe the issue that requires attention..."
                                    PlaceholderColor="#5F656D"
                                    TextColor="#E4E5E7"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="100"
                                    FontSize="12"
                                    SemanticProperties.Description="Details about the flagged issue" />

                            </Border>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- FLAG SAVE STATUS -->
                <!-- ================================================= -->

                <Border
                    IsVisible="{Binding IsFlagUploaded}"
                    BackgroundColor="#111916"
                    Stroke="#263C2E"
                    StrokeThickness="1"
                    Padding="12"
                    Margin="0,12,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Label
                        Text="✓ FLAG SAVED TO JOB CARD"
                        TextColor="#73B986"
                        FontSize="10"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                </Border>

                <Border
                    IsVisible="{Binding IsFlagPendingSync}"
                    BackgroundColor="#1C1710"
                    Stroke="#4A3A1A"
                    StrokeThickness="1"
                    Padding="12"
                    Margin="0,12,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="⏳ FLAG SAVED ON THIS DEVICE — NOT YET UPLOADED"
                            TextColor="#E0A030"
                            FontSize="10"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="This flag will upload to SmartJob the next time you sync."
                            TextColor="#B59354"
                            FontSize="9"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

                <!-- ================================================= -->
                <!-- FLAG WARNING -->
                <!-- ================================================= -->

                <Border
                    IsVisible="{Binding IsFlagged}"
                    BackgroundColor="#241416"
                    Stroke="#5A292D"
                    StrokeThickness="1"
                    Padding="14"
                    Margin="0,12,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="3,*"
                        ColumnSpacing="12">

                        <BoxView
                            Grid.Column="0"
                            WidthRequest="3"
                            Color="#ED3B3B"
                            CornerRadius="2" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="MANAGER ATTENTION REQUIRED"
                                TextColor="#ED7777"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.7" />

                            <Label
                                Text="This job will be flagged for Manager attention."
                                TextColor="#B47B7E"
                                FontSize="10" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- SECTION CHECKS -->
                <VerticalStackLayout
                    x:Name="SectionChecklistHost"
                    Margin="0,24,0,0" />

                <!-- ERROR -->
                <!-- ================================================= -->

                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#241416"
                    Stroke="#5A292D"
                    StrokeThickness="1"
                    Padding="14"
                    Margin="0,18,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="#EF7777"
                        FontSize="11"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </Border>


                <!-- ================================================= -->
                <!-- CONTINUE -->
                <!-- ================================================= -->

                <Button
                    Text="SAVE &amp; CONTINUE"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanContinue}"
                    BackgroundColor="#ED3B3B"
                    TextColor="#FFFFFF"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    HeightRequest="52"
                    CornerRadius="6"
                    Margin="0,28,0,0"
                    SemanticProperties.Description="Save comments and continue" />


                <!-- FOOTER -->
                <BoxView
                    HeightRequest="1"
                    Color="#20242A"
                    Margin="0,28,0,0" />

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,12,0,0">

                    <Label
                        Text="VERTECO SMARTJOB"
                        TextColor="#50555C"
                        FontSize="8"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5" />

                    <Label
                        Grid.Column="1"
                        Text="COMMENTS &amp; FLAG"
                        TextColor="#50555C"
                        FontSize="8"
                        CharacterSpacing="1.2" />

                </Grid>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
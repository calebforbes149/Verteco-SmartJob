<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="SmartJobMobile.Views.SignaturePage"
    BackgroundColor="#0A0C0F"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,22,24,0"
            Spacing="0">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <!-- BACK -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#111419"
                    Stroke="#272B31"
                    StrokeThickness="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="BackButton_Clicked" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="‹"
                        TextColor="#B8BCC2"
                        FontSize="30"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-3,0,0"
                        SemanticProperties.Description="Go back" />

                </Border>

                <!-- BRAND -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="VERTECO"
                        TextColor="#F2F2F2"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2.2" />

                    <HorizontalStackLayout Spacing="4">

                        <Label
                            Text="SMART"
                            TextColor="#FFFFFF"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="JOB"
                            TextColor="#ED3B3B"
                            FontSize="20"
                            FontAttributes="Bold" />

                    </HorizontalStackLayout>

                    <Label
                        Text="TECHNICIAN CONSOLE"
                        TextColor="#686E76"
                        FontSize="7"
                        FontAttributes="Bold"
                        CharacterSpacing="1.6" />

                </VerticalStackLayout>

            </Grid>

            <BoxView
                HeightRequest="1"
                Color="#24282E"
                Margin="0,20,0,0" />

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="24,26,24,32"
                Spacing="0">

                <!-- PAGE INTRO -->
                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="FIELD WORKFLOW"
                        TextColor="#ED3B3B"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2" />

                    <Label
                        Text="Signatures"
                        TextColor="#FFFFFF"
                        FontSize="30"
                        FontAttributes="Bold"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="Confirm completion of the work with technician and client approval."
                        TextColor="#7C828A"
                        FontSize="12"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- CURRENT JOB -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="0"
                    Margin="0,24,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="0">

                        <BoxView
                            HeightRequest="2"
                            Color="#ED3B3B" />

                        <VerticalStackLayout
                            Padding="18"
                            Spacing="0">

                            <Label
                                Text="CURRENT JOB"
                                TextColor="#646A72"
                                FontSize="8"
                                FontAttributes="Bold"
                                CharacterSpacing="1.4" />

                            <Label
                                Text="{Binding JobNumber}"
                                TextColor="#ED3B3B"
                                FontSize="12"
                                FontAttributes="Bold"
                                Margin="0,4,0,0" />

                            <Label
                                Text="{Binding JobTitle}"
                                TextColor="#FFFFFF"
                                FontSize="19"
                                FontAttributes="Bold"
                                Margin="0,9,0,0"
                                LineBreakMode="WordWrap" />

                            <Label
                                Text="{Binding JobLocation}"
                                TextColor="#7C828A"
                                FontSize="11"
                                Margin="0,5,0,0"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- TECHNICIAN -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,28,0,12">

                    <Label
                        Text="TECHNICIAN CONFIRMATION"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5" />

                    <Label
                        Text="Technician details and signature"
                        TextColor="#646A72"
                        FontSize="10" />

                </VerticalStackLayout>


                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="0">

                        <!-- TECHNICIAN NAME -->
                        <Label
                            Text="TECHNICIAN NAME *"
                            TextColor="#8D939A"
                            FontSize="9"
                            FontAttributes="Bold"
                            CharacterSpacing="0.8" />

                        <Border
                            BackgroundColor="#171A1F"
                            Stroke="#30343A"
                            StrokeThickness="1"
                            Padding="5"
                            Margin="0,7,0,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry
                                Text="{Binding TechnicianName}"
                                Placeholder="Enter technician full name"
                                PlaceholderColor="#5F656D"
                                TextColor="#E4E5E7"
                                BackgroundColor="Transparent"
                                Margin="8,0"
                                MinimumHeightRequest="48"
                                FontSize="12"
                                SemanticProperties.Description="Technician full name" />

                        </Border>


                        <!-- TECHNICIAN SIGNATURE -->
                        <VerticalStackLayout
                            IsVisible="{Binding HasTechnicianSignature}"
                            Spacing="8"
                            Margin="0,16,0,4">
                            <Label
                                Text="SAVED TECHNICIAN SIGNATURE"
                                TextColor="#73B986"
                                FontSize="10"
                                FontAttributes="Bold" />
                            <Image
                                Source="{Binding TechnicianSignaturePreview}"
                                HeightRequest="120"
                                BackgroundColor="#F5F5F3"
                                Aspect="AspectFit" />
                            <Button
                                Text="REMOVE SAVED SIGNATURE"
                                Clicked="RemoveTechnicianSignature_Clicked"
                                BackgroundColor="Transparent"
                                TextColor="#ED6464" />
                            <Label
                                Text="Leave the pad empty to keep this signature, or draw a new one to replace it."
                                TextColor="#858B93"
                                FontSize="10" />
                        </VerticalStackLayout>

                        <Label
                            Text="TECHNICIAN SIGNATURE *"
                            TextColor="#8D939A"
                            FontSize="9"
                            FontAttributes="Bold"
                            CharacterSpacing="0.8"
                            Margin="0,20,0,0" />

                        <Label
                            Text="Use your finger or pointer to sign inside the area below."
                            TextColor="#646A72"
                            FontSize="10"
                            Margin="0,4,0,8" />

                        <Border
                            BackgroundColor="#F5F5F3"
                            Stroke="#444950"
                            StrokeThickness="1"
                            HeightRequest="180"
                            Padding="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid>

                                <Label
                                    Text="SIGN HERE"
                                    TextColor="#B0B2B5"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1.2"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    InputTransparent="True" />

                                <toolkit:DrawingView
                                    x:Name="TechnicianSignaturePad"
                                    BackgroundColor="Transparent"
                                    LineColor="Black"
                                    LineWidth="4"
                                    SemanticProperties.Description="Technician signature pad" />

                            </Grid>

                        </Border>


                        <!-- CLEAR TECHNICIAN SIGNATURE -->
                        <Button
                            Text="CLEAR SIGNATURE"
                            Clicked="ClearTechnicianSignature_Clicked"
                            BackgroundColor="#171A1F"
                            TextColor="#BFC3C8"
                            BorderColor="#34383E"
                            BorderWidth="1"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="0.6"
                            HeightRequest="46"
                            CornerRadius="6"
                            Margin="0,10,0,0"
                            SemanticProperties.Description="Clear technician signature" />


                        <!-- TECHNICIAN CONFIRMATION -->
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12"
                            Margin="0,18,0,0">

                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{Binding TechnicianConfirmed}"
                                Color="#ED3B3B"
                                VerticalOptions="Start"
                                MinimumWidthRequest="44"
                                MinimumHeightRequest="44"
                                SemanticProperties.Description="Technician confirms the work information is correct" />

                            <Label
                                Grid.Column="1"
                                Text="I confirm that the recorded job information is accurate and the work has been completed as stated."
                                TextColor="#A0A5AB"
                                FontSize="11"
                                LineHeight="1.25"
                                VerticalOptions="Center"
                                LineBreakMode="WordWrap" />

                        </Grid>


                        <!-- TECHNICIAN CONFIRMED -->
                        <Border
                            IsVisible="{Binding TechnicianConfirmed}"
                            BackgroundColor="#111916"
                            Stroke="#263C2E"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,12,0,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>

                            <Label
                                Text="TECHNICIAN CONFIRMATION RECORDED"
                                TextColor="#73B986"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.5"
                                HorizontalTextAlignment="Center" />

                        </Border>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- CLIENT -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,28,0,12">

                    <Label
                        Text="CLIENT CONFIRMATION"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5" />

                    <Label
                        Text="Client approval and signature"
                        TextColor="#646A72"
                        FontSize="10" />

                </VerticalStackLayout>


                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="0">

                        <!-- CLIENT NAME -->
                        <Label
                            Text="CLIENT NAME *"
                            TextColor="#8D939A"
                            FontSize="9"
                            FontAttributes="Bold"
                            CharacterSpacing="0.8" />

                        <Border
                            BackgroundColor="#171A1F"
                            Stroke="#30343A"
                            StrokeThickness="1"
                            Padding="5"
                            Margin="0,7,0,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Entry
                                Text="{Binding ClientName}"
                                Placeholder="Enter client full name"
                                PlaceholderColor="#5F656D"
                                TextColor="#E4E5E7"
                                BackgroundColor="Transparent"
                                Margin="8,0"
                                MinimumHeightRequest="48"
                                FontSize="12"
                                SemanticProperties.Description="Client full name" />

                        </Border>


                        <!-- CLIENT SIGNATURE -->
                        <VerticalStackLayout
                            IsVisible="{Binding HasClientSignature}"
                            Spacing="8"
                            Margin="0,16,0,4">
                            <Label
                                Text="SAVED CLIENT SIGNATURE"
                                TextColor="#73B986"
                                FontSize="10"
                                FontAttributes="Bold" />
                            <Image
                                Source="{Binding ClientSignaturePreview}"
                                HeightRequest="120"
                                BackgroundColor="#F5F5F3"
                                Aspect="AspectFit" />
                            <Button
                                Text="REMOVE SAVED SIGNATURE"
                                Clicked="RemoveClientSignature_Clicked"
                                BackgroundColor="Transparent"
                                TextColor="#ED6464" />
                            <Label
                                Text="Leave the pad empty to keep this signature, or draw a new one to replace it."
                                TextColor="#858B93"
                                FontSize="10" />
                        </VerticalStackLayout>

                        <Label
                            Text="CLIENT SIGNATURE *"
                            TextColor="#8D939A"
                            FontSize="9"
                            FontAttributes="Bold"
                            CharacterSpacing="0.8"
                            Margin="0,20,0,0" />

                        <Label
                            Text="Ask the client to sign inside the area below."
                            TextColor="#646A72"
                            FontSize="10"
                            Margin="0,4,0,8" />

                        <Border
                            BackgroundColor="#F5F5F3"
                            Stroke="#444950"
                            StrokeThickness="1"
                            HeightRequest="180"
                            Padding="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid>

                                <Label
                                    Text="SIGN HERE"
                                    TextColor="#B0B2B5"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1.2"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    InputTransparent="True" />

                                <toolkit:DrawingView
                                    x:Name="ClientSignaturePad"
                                    BackgroundColor="Transparent"
                                    LineColor="Black"
                                    LineWidth="4"
                                    SemanticProperties.Description="Client signature pad" />

                            </Grid>

                        </Border>


                        <!-- CLEAR CLIENT SIGNATURE -->
                        <Button
                            Text="CLEAR SIGNATURE"
                            Clicked="ClearClientSignature_Clicked"
                            BackgroundColor="#171A1F"
                            TextColor="#BFC3C8"
                            BorderColor="#34383E"
                            BorderWidth="1"
                            FontSize="10"
                            FontAttributes="Bold"
                            CharacterSpacing="0.6"
                            HeightRequest="46"
                            CornerRadius="6"
                            Margin="0,10,0,0"
                            SemanticProperties.Description="Clear client signature" />


                        <!-- CLIENT CONFIRMATION -->
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="12"
                            Margin="0,18,0,0">

                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{Binding ClientConfirmed}"
                                Color="#ED3B3B"
                                VerticalOptions="Start"
                                MinimumWidthRequest="44"
                                MinimumHeightRequest="44"
                                SemanticProperties.Description="Client confirms the work was completed" />

                            <Label
                                Grid.Column="1"
                                Text="The client confirms that the work has been completed and the job details have been reviewed."
                                TextColor="#A0A5AB"
                                FontSize="11"
                                LineHeight="1.25"
                                VerticalOptions="Center"
                                LineBreakMode="WordWrap" />

                        </Grid>


                        <!-- CLIENT CONFIRMED -->
                        <Border
                            IsVisible="{Binding ClientConfirmed}"
                            BackgroundColor="#111916"
                            Stroke="#263C2E"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,12,0,0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>

                            <Label
                                Text="CLIENT CONFIRMATION RECORDED"
                                TextColor="#73B986"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.5"
                                HorizontalTextAlignment="Center" />

                        </Border>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- REQUIREMENT NOTICE -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="14"
                    Margin="0,18,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="3,*"
                        ColumnSpacing="12">

                        <BoxView
                            Grid.Column="0"
                            WidthRequest="3"
                            Color="#ED3B3B"
                            CornerRadius="2" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="SIGNATURE REQUIREMENT"
                                TextColor="#DADDE0"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.7" />

                            <Label
                                Text="Both signatures and confirmations are required before the job can proceed to final review."
                                TextColor="#7C828A"
                                FontSize="10"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <Label
                    Text="The sign-off check is marked complete after both signatures are saved."
                    TextColor="#858B93"
                    FontSize="11"
                    Margin="0,22,0,0"
                    LineBreakMode="WordWrap" />

                <!-- ERROR -->
                <!-- ================================================= -->

                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#241416"
                    Stroke="#5A292D"
                    StrokeThickness="1"
                    Padding="14"
                    Margin="0,18,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="#EF7777"
                        FontSize="11"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </Border>


                <!-- ================================================= -->
                <!-- CONTINUE -->
                <!-- ================================================= -->

                <Button
                    Text="CONTINUE TO REVIEW"
                    Clicked="ContinueToReview_Clicked"
                    IsEnabled="{Binding CanContinue}"
                    BackgroundColor="#ED3B3B"
                    TextColor="#FFFFFF"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    HeightRequest="52"
                    CornerRadius="6"
                    Margin="0,28,0,0"
                    SemanticProperties.Description="Continue to final job review" />


                <!-- FOOTER -->
                <BoxView
                    HeightRequest="1"
                    Color="#20242A"
                    Margin="0,28,0,0" />

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,12,0,0">

                    <Label
                        Text="VERTECO SMARTJOB"
                        TextColor="#50555C"
                        FontSize="8"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5" />

                    <Label
                        Grid.Column="1"
                        Text="SIGNATURES"
                        TextColor="#50555C"
                        FontSize="8"
                        CharacterSpacing="1.2" />

                </Grid>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
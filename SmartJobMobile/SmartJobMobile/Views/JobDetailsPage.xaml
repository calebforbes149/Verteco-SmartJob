<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.JobDetailsPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <!-- Header -->
            <Grid
                ColumnDefinitions="Auto,*"
                Margin="0,10,0,10">

                <Button
                    Grid.Column="0"
                    Text="‹"
                    FontSize="28"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    WidthRequest="50"
                    HeightRequest="50"
                    Clicked="BackButton_Clicked"
                    SemanticProperties.Description="Go back to My Jobs" />

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="JOB DETAILS"
                        TextColor="#E53935"
                        FontSize="24"
                        FontAttributes="Bold"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="Review your assigned job"
                        TextColor="#9E9E9E"
                        FontSize="12" />

                </VerticalStackLayout>

            </Grid>

            <!-- Job Heading -->
            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Grid.Column="0"
                            Text="{Binding SelectedJob.JobNumber}"
                            TextColor="#E53935"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding SelectedJob.Priority}"
                            TextColor="#FFC107"
                            FontSize="13"
                            FontAttributes="Bold" />

                    </Grid>

                    <Label
                        Text="{Binding SelectedJob.Title}"
                        TextColor="White"
                        FontSize="24"
                        FontAttributes="Bold" />

                    <Label
                        Text="{Binding SelectedJob.Status}"
                        TextColor="#4CAF50"
                        FontSize="13"
                        FontAttributes="Bold" />

                </VerticalStackLayout>

            </Border>

            <!-- Job Information -->
            <Label
                Text="JOB INFORMATION"
                TextColor="#BDBDBD"
                FontSize="12"
                FontAttributes="Bold"
                CharacterSpacing="1" />

            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="18">

                    <!-- Customer -->
                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="CUSTOMER"
                            TextColor="#757575"
                            FontSize="11"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding SelectedJob.CustomerName}"
                            TextColor="White"
                            FontSize="15" />

                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="#333333" />

                    <!-- Location -->
                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="LOCATION"
                            TextColor="#757575"
                            FontSize="11"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding SelectedJob.Location}"
                            TextColor="White"
                            FontSize="15" />

                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="#333333" />

                    <!-- Scheduled -->
                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="SCHEDULED"
                            TextColor="#757575"
                            FontSize="11"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding SelectedJob.ScheduledDateDisplay}"
                            TextColor="White"
                            FontSize="15" />

                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="#333333" />

                    <!-- Priority -->
                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="PRIORITY"
                            TextColor="#757575"
                            FontSize="11"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding SelectedJob.Priority}"
                            TextColor="#FFC107"
                            FontSize="15"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Instructions -->
            <Label
                Text="WORK INSTRUCTIONS"
                TextColor="#BDBDBD"
                FontSize="12"
                FontAttributes="Bold"
                CharacterSpacing="1" />

            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Label
                    Text="Review the job requirements before starting. Complete all required checklist items and capture the necessary evidence before submitting the job."
                    TextColor="#BDBDBD"
                    FontSize="14"
                    LineHeight="1.4" />

            </Border>

            <!-- Start Job -->
            <Button
                Text="START JOB"
                BackgroundColor="#E53935"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="54"
                CornerRadius="10"
                Margin="0,5,0,0"
                Command="{Binding StartJobCommand}"
                SemanticProperties.Description="Start this SmartJob job" />

            <Label
                Text="SmartJob Mobile"
                TextColor="#616161"
                FontSize="11"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,20" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
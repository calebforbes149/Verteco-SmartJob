<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.JobDetailsPage"
    BackgroundColor="#0A0C0F"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,22,24,32"
            Spacing="0">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <!-- BACK -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#111419"
                    Stroke="#272B31"
                    StrokeThickness="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="BackButton_Clicked" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="‹"
                        TextColor="#B8BCC2"
                        FontSize="30"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-3,0,0"
                        SemanticProperties.Description="Go back to My Jobs" />

                </Border>


                <!-- BRAND -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="VERTECO"
                        TextColor="#F2F2F2"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2.2" />

                    <HorizontalStackLayout Spacing="4">

                        <Label
                            Text="SMART"
                            TextColor="#FFFFFF"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="JOB"
                            TextColor="#ED3B3B"
                            FontSize="20"
                            FontAttributes="Bold" />

                    </HorizontalStackLayout>

                    <Label
                        Text="TECHNICIAN CONSOLE"
                        TextColor="#686E76"
                        FontSize="7"
                        FontAttributes="Bold"
                        CharacterSpacing="1.6" />

                </VerticalStackLayout>

            </Grid>


            <!-- HEADER DIVIDER -->
            <BoxView
                HeightRequest="1"
                Color="#24282E"
                Margin="0,20,0,0" />


            <!-- ================================================= -->
            <!-- PAGE INTRO -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="5"
                Margin="0,26,0,0">

                <Label
                    Text="FIELD OPERATIONS"
                    TextColor="#ED3B3B"
                    FontSize="9"
                    FontAttributes="Bold"
                    CharacterSpacing="2" />

                <Label
                    Text="Job Details"
                    TextColor="#FFFFFF"
                    FontSize="30"
                    FontAttributes="Bold"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Review the job card before beginning field work."
                    TextColor="#7C828A"
                    FontSize="12" />

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- JOB CARD HEADER -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#111419"
                Stroke="#292D33"
                StrokeThickness="1"
                Padding="0"
                Margin="0,24,0,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">

                    <!-- RED TOP ACCENT -->
                    <BoxView
                        HeightRequest="2"
                        Color="#ED3B3B"
                        HorizontalOptions="Fill" />


                    <VerticalStackLayout
                        Padding="18"
                        Spacing="0">

                        <!-- JOB NUMBER / PRIORITY -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="10">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="3">

                                <Label
                                    Text="JOB CARD"
                                    TextColor="#646A72"
                                    FontSize="8"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1.4" />

                                <Label
                                    Text="{Binding SelectedJob.JobNumber}"
                                    TextColor="#ED3B3B"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    CharacterSpacing="0.5" />

                            </VerticalStackLayout>


                            <!-- PRIORITY BADGE -->
                            <Border
                                Grid.Column="1"
                                BackgroundColor="#181B20"
                                Stroke="#343941"
                                StrokeThickness="1"
                                Padding="9,5"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5" />
                                </Border.StrokeShape>

                                <Label
                                    Text="{Binding SelectedJob.Priority}"
                                    TextColor="#D6D8DB"
                                    FontSize="9"
                                    FontAttributes="Bold"
                                    CharacterSpacing="0.5" />

                            </Border>

                        </Grid>


                        <!-- TITLE -->
                        <Label
                            Text="{Binding SelectedJob.Title}"
                            TextColor="#FFFFFF"
                            FontSize="22"
                            FontAttributes="Bold"
                            Margin="0,15,0,0"
                            LineBreakMode="WordWrap" />


                        <!-- STATUS -->
                        <HorizontalStackLayout
                            Spacing="7"
                            Margin="0,9,0,0">

                            <BoxView
                                WidthRequest="6"
                                HeightRequest="6"
                                CornerRadius="3"
                                Color="#ED3B3B"
                                VerticalOptions="Center" />

                            <Label
                                Text="{Binding SelectedJob.Status}"
                                TextColor="#C7CACD"
                                FontSize="10"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- JOB INFORMATION HEADING -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="2"
                Margin="0,28,0,12">

                <Label
                    Text="JOB INFORMATION"
                    TextColor="#FFFFFF"
                    FontSize="14"
                    FontAttributes="Bold"
                    CharacterSpacing="0.5" />

                <Label
                    Text="Assignment and scheduling details"
                    TextColor="#646A72"
                    FontSize="10" />

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- JOB INFORMATION -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#111419"
                Stroke="#292D33"
                StrokeThickness="1"
                Padding="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">


                    <!-- CUSTOMER -->
                    <Grid
                        ColumnDefinitions="105,*"
                        Padding="18,16"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            Text="CUSTOMER"
                            TextColor="#5F656D"
                            FontSize="8"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding SelectedJob.CustomerName}"
                            TextColor="#D5D7DA"
                            FontSize="12"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap" />

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        Color="#25292F"
                        Margin="18,0" />


                    <!-- LOCATION -->
                    <Grid
                        ColumnDefinitions="105,*"
                        Padding="18,16"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            Text="LOCATION"
                            TextColor="#5F656D"
                            FontSize="8"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding SelectedJob.Location}"
                            TextColor="#D5D7DA"
                            FontSize="12"
                            LineBreakMode="WordWrap" />

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        Color="#25292F"
                        Margin="18,0" />


                    <!-- SCHEDULED -->
                    <Grid
                        ColumnDefinitions="105,*"
                        Padding="18,16"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            Text="SCHEDULED"
                            TextColor="#5F656D"
                            FontSize="8"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding SelectedJob.ScheduledDateDisplay}"
                            TextColor="#D5D7DA"
                            FontSize="12" />

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        Color="#25292F"
                        Margin="18,0" />


                    <!-- PRIORITY -->
                    <Grid
                        ColumnDefinitions="105,*"
                        Padding="18,16"
                        ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            Text="PRIORITY"
                            TextColor="#5F656D"
                            FontSize="8"
                            FontAttributes="Bold"
                            CharacterSpacing="1"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding SelectedJob.Priority}"
                            TextColor="#D5D7DA"
                            FontSize="12"
                            FontAttributes="Bold" />

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- WORK INSTRUCTIONS -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="2"
                Margin="0,28,0,12">

                <Label
                    Text="WORK INSTRUCTIONS"
                    TextColor="#FFFFFF"
                    FontSize="14"
                    FontAttributes="Bold"
                    CharacterSpacing="0.5" />

                <Label
                    Text="Required technician workflow"
                    TextColor="#646A72"
                    FontSize="10" />

            </VerticalStackLayout>


            <Border
                BackgroundColor="#111419"
                Stroke="#292D33"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="3,*"
                    ColumnSpacing="14">

                    <!-- RED ACCENT -->
                    <BoxView
                        Grid.Column="0"
                        WidthRequest="3"
                        Color="#ED3B3B"
                        CornerRadius="2"
                        HorizontalOptions="Start" />


                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="7">

                        <Label
                            Text="BEFORE YOU START"
                            TextColor="#DADDE0"
                            FontSize="9"
                            FontAttributes="Bold"
                            CharacterSpacing="1" />

                        <Label
                            Text="Review the job requirements before starting. Complete all required checklist items and capture the necessary evidence before submitting the job."
                            TextColor="#8D939A"
                            FontSize="11"
                            LineHeight="1.4" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- START JOB -->
            <!-- ================================================= -->

            <Button
                Text="START JOB"
                BackgroundColor="#ED3B3B"
                TextColor="#FFFFFF"
                FontAttributes="Bold"
                FontSize="12"
                CharacterSpacing="0.8"
                HeightRequest="52"
                CornerRadius="6"
                Margin="0,28,0,0"
                Command="{Binding StartJobCommand}"
                SemanticProperties.Description="Start this SmartJob job" />


            <!-- FOOTER -->
            <BoxView
                HeightRequest="1"
                Color="#20242A"
                Margin="0,28,0,0" />


            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,12,0,0">

                <Label
                    Text="VERTECO SMARTJOB"
                    TextColor="#50555C"
                    FontSize="8"
                    FontAttributes="Bold"
                    CharacterSpacing="1.5" />

                <Label
                    Grid.Column="1"
                    Text="FIELD OPERATIONS"
                    TextColor="#50555C"
                    FontSize="8"
                    CharacterSpacing="1.2" />

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
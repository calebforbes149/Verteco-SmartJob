<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.DashboardPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="22">

            <!-- HEADER -->
            <Grid
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="10"
                Margin="0,15,0,5">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="2">

                    <Label
                        Text="SMARTJOB"
                        TextColor="#E53935"
                        FontSize="26"
                        FontAttributes="Bold"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="Technician Dashboard"
                        TextColor="#BDBDBD"
                        FontSize="13" />

                </VerticalStackLayout>

                <!-- NOTIFICATIONS BUTTON -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="#1E1E1E"
                    Stroke="#424242"
                    StrokeThickness="1"
                    Padding="15,10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="Notifications_Tapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        Spacing="1"
                        HorizontalOptions="Center">

                        <Label
                            Text="NOTIFICATIONS"
                            TextColor="#BDBDBD"
                            FontSize="9"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="{Binding NotificationCount}"
                            TextColor="#E53935"
                            FontSize="18"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

                <!-- PROFILE BUTTON -->
                <Border
    Grid.Column="2"
    BackgroundColor="#1E1E1E"
    Stroke="#424242"
    StrokeThickness="1"
    Padding="15,10">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
            Tapped="Profile_Tapped" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
        Spacing="1"
        HorizontalOptions="Center"
        VerticalOptions="Center">

                        <Label
            Text="👤"
            FontSize="17"
            HorizontalTextAlignment="Center" />

                        <Label
            Text="PROFILE"
            TextColor="#BDBDBD"
            FontSize="9"
            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- WELCOME -->
            <VerticalStackLayout Spacing="4">

                <Label
                    Text="Welcome back,"
                    TextColor="#BDBDBD"
                    FontSize="14" />

                <Label
                    Text="{Binding TechnicianName}"
                    TextColor="White"
                    FontSize="27"
                    FontAttributes="Bold" />

                <Label
                    Text="Here's an overview of your assigned work."
                    TextColor="#9E9E9E"
                    FontSize="13" />

            </VerticalStackLayout>

            <!-- CONNECTION STATUS -->
            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#333333"
                StrokeThickness="1"
                Padding="15,10">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <BoxView
                        Grid.Column="0"
                        Color="#4CAF50"
                        WidthRequest="9"
                        HeightRequest="9"
                        CornerRadius="5"
                        VerticalOptions="Center"
                        Margin="0,0,8,0" />

                    <Label
                        Grid.Column="1"
                        Text="{Binding ConnectionStatus}"
                        TextColor="White"
                        FontSize="13"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="2"
                        Text="Synced"
                        TextColor="#4CAF50"
                        FontSize="12"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <!-- SECTION HEADING -->
            <Label
                Text="JOB OVERVIEW"
                TextColor="#BDBDBD"
                FontSize="12"
                FontAttributes="Bold"
                CharacterSpacing="1" />

            <!-- ASSIGNED JOBS -->
            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">

                        <Label
                            Text="Assigned Jobs"
                            TextColor="White"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            Text="Jobs waiting for your attention"
                            TextColor="#9E9E9E"
                            FontSize="12" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="{Binding AssignedJobs}"
                        TextColor="#E53935"
                        FontSize="30"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <!-- IN PROGRESS -->
            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">

                        <Label
                            Text="In Progress"
                            TextColor="White"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            Text="Jobs currently being worked on"
                            TextColor="#9E9E9E"
                            FontSize="12" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="{Binding InProgressJobs}"
                        TextColor="#FFC107"
                        FontSize="30"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <!-- COMPLETED -->
            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="5">

                        <Label
                            Text="Completed"
                            TextColor="White"
                            FontSize="17"
                            FontAttributes="Bold" />

                        <Label
                            Text="Successfully completed jobs"
                            TextColor="#9E9E9E"
                            FontSize="12" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="{Binding CompletedJobs}"
                        TextColor="#4CAF50"
                        FontSize="30"
                        FontAttributes="Bold"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <!-- VIEW JOBS -->
            <Button
                Text="VIEW MY JOBS"
                BackgroundColor="#E53935"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="15"
                HeightRequest="52"
                CornerRadius="10"
                Margin="0,5,0,0"
                SemanticProperties.Description="View your assigned SmartJob jobs"
                Clicked="ViewJobsButton_Clicked" />

            <!-- SYNC -->
            <Button
                Text="SYNC NOW"
                BackgroundColor="#1E1E1E"
                BorderColor="#E53935"
                BorderWidth="1"
                TextColor="#E53935"
                FontAttributes="Bold"
                FontSize="14"
                HeightRequest="50"
                CornerRadius="10"
                SemanticProperties.Description="Open SmartJob synchronisation"
                Clicked="SyncButton_Clicked" />
            <Label
                Text="SmartJob Mobile"
                TextColor="#616161"
                FontSize="11"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,20" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
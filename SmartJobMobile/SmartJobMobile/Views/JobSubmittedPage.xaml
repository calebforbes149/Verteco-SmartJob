<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.JobSubmittedPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="22"
            VerticalOptions="Center">

            <!-- SUCCESS ICON -->
            <Border
                BackgroundColor="#263D2A"
                Stroke="#4CAF50"
                StrokeThickness="2"
                HeightRequest="100"
                WidthRequest="100"
                HorizontalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="50" />
                </Border.StrokeShape>

                <Label
                    Text="✓"
                    TextColor="#66BB6A"
                    FontSize="52"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    SemanticProperties.Description="Job submitted successfully" />

            </Border>

            <!-- SUCCESS MESSAGE -->
            <VerticalStackLayout Spacing="8">

                <Label
                    Text="JOB SUBMITTED"
                    TextColor="White"
                    FontSize="25"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Your job has been submitted successfully."
                    TextColor="#BDBDBD"
                    FontSize="14"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- JOB SUMMARY -->
            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#383838"
                StrokeThickness="1"
                Padding="20">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Submission Details"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold" />

                    <BoxView
                        HeightRequest="1"
                        Color="#383838" />

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="12">

                        <!-- JOB NUMBER -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Job Number"
                            TextColor="#9E9E9E"
                            FontSize="13" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding JobNumber}"
                            TextColor="White"
                            FontSize="13"
                            FontAttributes="Bold" />

                        <!-- JOB TYPE -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Job Type"
                            TextColor="#9E9E9E"
                            FontSize="13" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Title}"
                            TextColor="White"
                            FontSize="13" />

                        <!-- STATUS -->
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Status"
                            TextColor="#9E9E9E"
                            FontSize="13" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="{Binding Status}"
                            TextColor="#66BB6A"
                            FontSize="13"
                            FontAttributes="Bold" />

                        <!-- SITE -->
                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="Site"
                            TextColor="#9E9E9E"
                            FontSize="13" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="{Binding Location}"
                            TextColor="White"
                            FontSize="13"
                            HorizontalTextAlignment="End"
                            LineBreakMode="TailTruncation"
                            MaximumWidthRequest="220" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- INFORMATION -->
            <Border
                BackgroundColor="#252525"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="15">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="What happens next?"
                        TextColor="#E53935"
                        FontSize="14"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="The submitted job will be available for Manager review. You can return to My Jobs to continue working on your assigned jobs."
                        TextColor="#BDBDBD"
                        FontSize="12"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>

            <!-- MY JOBS -->
            <Button
                Text="RETURN TO MY JOBS"
                BackgroundColor="#E53935"
                TextColor="White"
                FontSize="15"
                FontAttributes="Bold"
                HeightRequest="52"
                CornerRadius="10"
                Clicked="MyJobsButton_Clicked"
                SemanticProperties.Description="Return to My Jobs" />

            <!-- DASHBOARD -->
            <Button
                Text="RETURN TO DASHBOARD"
                BackgroundColor="#252525"
                TextColor="White"
                BorderColor="#555555"
                BorderWidth="1"
                FontSize="14"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="10"
                Clicked="DashboardButton_Clicked"
                SemanticProperties.Description="Return to dashboard" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.JobSubmittedPage"
    BackgroundColor="#0A0C0F"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,24,24,32"
            Spacing="0">

            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="2">

                <Label
                    Text="VERTECO"
                    TextColor="#F2F2F2"
                    FontSize="9"
                    FontAttributes="Bold"
                    CharacterSpacing="2.2"
                    HorizontalTextAlignment="Center" />

                <HorizontalStackLayout
                    Spacing="4"
                    HorizontalOptions="Center">

                    <Label
                        Text="SMART"
                        TextColor="#FFFFFF"
                        FontSize="20"
                        FontAttributes="Bold" />

                    <Label
                        Text="JOB"
                        TextColor="#ED3B3B"
                        FontSize="20"
                        FontAttributes="Bold" />

                </HorizontalStackLayout>

                <Label
                    Text="TECHNICIAN CONSOLE"
                    TextColor="#686E76"
                    FontSize="7"
                    FontAttributes="Bold"
                    CharacterSpacing="1.6"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <BoxView
                HeightRequest="1"
                Color="#24282E"
                Margin="0,20,0,0" />


            <!-- ================================================= -->
            <!-- SUCCESS -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="0"
                Margin="0,42,0,0">

                <!-- SUCCESS ICON -->
                <Border
                    BackgroundColor="#111916"
                    Stroke="#2D5238"
                    StrokeThickness="1"
                    HeightRequest="82"
                    WidthRequest="82"
                    HorizontalOptions="Center"
                    Padding="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="41" />
                    </Border.StrokeShape>

                    <Label
                        Text="✓"
                        TextColor="#73B986"
                        FontSize="38"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        SemanticProperties.Description="Job submitted successfully" />

                </Border>


                <Label
                    Text="SUBMISSION COMPLETE"
                    TextColor="#73B986"
                    FontSize="9"
                    FontAttributes="Bold"
                    CharacterSpacing="1.8"
                    HorizontalTextAlignment="Center"
                    Margin="0,20,0,0" />

                <Label
                    Text="Job Submitted"
                    TextColor="#FFFFFF"
                    FontSize="30"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    Margin="0,6,0,0"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="The completed job has been submitted successfully."
                    TextColor="#7C828A"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Margin="15,7,15,0" />

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- SUBMISSION DETAILS -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="2"
                Margin="0,34,0,12">

                <Label
                    Text="SUBMISSION DETAILS"
                    TextColor="#FFFFFF"
                    FontSize="14"
                    FontAttributes="Bold"
                    CharacterSpacing="0.5" />

                <Label
                    Text="Submitted job information"
                    TextColor="#646A72"
                    FontSize="10" />

            </VerticalStackLayout>


            <Border
                BackgroundColor="#111419"
                Stroke="#292D33"
                StrokeThickness="1"
                Padding="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">

                    <!-- RED ACCENT -->
                    <BoxView
                        HeightRequest="2"
                        Color="#ED3B3B" />


                    <VerticalStackLayout
                        Padding="18"
                        Spacing="0">

                        <!-- JOB NUMBER -->
                        <Label
                            Text="JOB NUMBER"
                            TextColor="#646A72"
                            FontSize="8"
                            FontAttributes="Bold"
                            CharacterSpacing="1" />

                        <Label
                            Text="{Binding JobNumber}"
                            TextColor="#ED3B3B"
                            FontSize="15"
                            FontAttributes="Bold"
                            Margin="0,5,0,0" />


                        <BoxView
                            HeightRequest="1"
                            Color="#292D33"
                            Margin="0,16,0,16" />


                        <!-- JOB TYPE -->
                        <Grid
                            ColumnDefinitions="95,*"
                            ColumnSpacing="12">

                            <Label
                                Grid.Column="0"
                                Text="JOB TYPE"
                                TextColor="#646A72"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.5" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Title}"
                                TextColor="#C4C7CB"
                                FontSize="11"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap" />

                        </Grid>


                        <!-- STATUS -->
                        <Grid
                            ColumnDefinitions="95,*"
                            ColumnSpacing="12"
                            Margin="0,14,0,0">

                            <Label
                                Grid.Column="0"
                                Text="STATUS"
                                TextColor="#646A72"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.5" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Status}"
                                TextColor="#73B986"
                                FontSize="11"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="End" />

                        </Grid>


                        <!-- SITE -->
                        <Grid
                            ColumnDefinitions="95,*"
                            ColumnSpacing="12"
                            Margin="0,14,0,0">

                            <Label
                                Grid.Column="0"
                                Text="SITE"
                                TextColor="#646A72"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.5" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Location}"
                                TextColor="#C4C7CB"
                                FontSize="11"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap" />

                        </Grid>

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- WHAT HAPPENS NEXT -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#111419"
                Stroke="#292D33"
                StrokeThickness="1"
                Padding="16"
                Margin="0,18,0,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="3,*"
                    ColumnSpacing="13">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="3"
                        Color="#ED3B3B"
                        CornerRadius="2" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="5">

                        <Label
                            Text="WHAT HAPPENS NEXT?"
                            TextColor="#E4E5E7"
                            FontSize="9"
                            FontAttributes="Bold"
                            CharacterSpacing="0.8" />

                        <Label
                            Text="The submitted job will be available for Manager review. You can return to My Jobs to continue working on your assigned jobs."
                            TextColor="#7C828A"
                            FontSize="10"
                            LineHeight="1.25"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- ACTIONS -->
            <!-- ================================================= -->

            <Button
                Text="RETURN TO MY JOBS"
                BackgroundColor="#ED3B3B"
                TextColor="#FFFFFF"
                FontSize="12"
                FontAttributes="Bold"
                CharacterSpacing="0.8"
                HeightRequest="52"
                CornerRadius="6"
                Margin="0,30,0,0"
                Clicked="MyJobsButton_Clicked"
                SemanticProperties.Description="Return to My Jobs" />


            <Button
                Text="RETURN TO DASHBOARD"
                BackgroundColor="#111419"
                TextColor="#BFC3C8"
                BorderColor="#34383E"
                BorderWidth="1"
                FontSize="11"
                FontAttributes="Bold"
                CharacterSpacing="0.7"
                HeightRequest="50"
                CornerRadius="6"
                Margin="0,10,0,0"
                Clicked="DashboardButton_Clicked"
                SemanticProperties.Description="Return to dashboard" />


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <BoxView
                HeightRequest="1"
                Color="#20242A"
                Margin="0,30,0,0" />

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,12,0,0">

                <Label
                    Text="VERTECO SMARTJOB"
                    TextColor="#50555C"
                    FontSize="8"
                    FontAttributes="Bold"
                    CharacterSpacing="1.5" />

                <Label
                    Grid.Column="1"
                    Text="SUBMITTED"
                    TextColor="#50555C"
                    FontSize="8"
                    CharacterSpacing="1.2" />

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
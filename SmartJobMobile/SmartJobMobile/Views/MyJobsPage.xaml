<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.MyJobsPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="Auto,*"
            Padding="20,25,20,15"
            BackgroundColor="#121212">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="28"
                TextColor="White"
                BackgroundColor="Transparent"
                WidthRequest="50"
                HeightRequest="50"
                Clicked="BackButton_Clicked"
                SemanticProperties.Description="Go back" />

            <VerticalStackLayout
                Grid.Column="1"
                VerticalOptions="Center"
                Spacing="2">

                <Label
                    Text="MY JOBS"
                    TextColor="#E53935"
                    FontSize="24"
                    FontAttributes="Bold"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Your assigned SmartJob work"
                    TextColor="#9E9E9E"
                    FontSize="12" />

            </VerticalStackLayout>

        </Grid>

        <!-- Job List -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Jobs}"
            SelectionMode="None"
            Margin="20,5,20,20">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="No jobs assigned"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Your assigned jobs will appear here."
                        TextColor="#9E9E9E"
                        FontSize="13"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        BackgroundColor="#1E1E1E"
                        Stroke="#424242"
                        StrokeThickness="1"
                        Padding="18"
                        Margin="0,7">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="10">

                            <!-- Job number and priority -->
                            <Grid ColumnDefinitions="*,Auto">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding JobNumber}"
                                    TextColor="#E53935"
                                    FontSize="13"
                                    FontAttributes="Bold" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Priority}"
                                    TextColor="#FFC107"
                                    FontSize="12"
                                    FontAttributes="Bold" />

                            </Grid>

                            <!-- Job title -->
                            <Label
                                Text="{Binding Title}"
                                TextColor="White"
                                FontSize="19"
                                FontAttributes="Bold" />

                            <!-- Customer -->
                            <Label
                                Text="{Binding CustomerName}"
                                TextColor="#BDBDBD"
                                FontSize="13" />

                            <!-- Location -->
                            <Grid ColumnDefinitions="80,*">

                                <Label
                                    Grid.Column="0"
                                    Text="Location"
                                    TextColor="#757575"
                                    FontSize="12" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Location}"
                                    TextColor="#BDBDBD"
                                    FontSize="12" />

                            </Grid>

                            <!-- Scheduled date -->
                            <Grid ColumnDefinitions="80,*">

                                <Label
                                    Grid.Column="0"
                                    Text="Scheduled"
                                    TextColor="#757575"
                                    FontSize="12" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding ScheduledDateDisplay}"
                                    TextColor="#BDBDBD"
                                    FontSize="12" />

                            </Grid>

                            <!-- Status -->
                            <Grid ColumnDefinitions="80,*">

                                <Label
                                    Grid.Column="0"
                                    Text="Status"
                                    TextColor="#757575"
                                    FontSize="12" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Status}"
                                    TextColor="#4CAF50"
                                    FontSize="12"
                                    FontAttributes="Bold" />

                            </Grid>

                            <Button
                                Text="VIEW JOB"
                                BackgroundColor="#2A2A2A"
                                BorderColor="#E53935"
                                BorderWidth="1"
                                TextColor="#E53935"
                                FontAttributes="Bold"
                                HeightRequest="46"
                                CornerRadius="9"
                                Margin="0,8,0,0"
                                CommandParameter="{Binding .}"
                                Clicked="ViewJobButton_Clicked"
                                SemanticProperties.Description="View job details" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
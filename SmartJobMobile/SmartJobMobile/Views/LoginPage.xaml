<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.LoginPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="18"
            VerticalOptions="Center">

            <!-- SmartJob Branding -->
            <VerticalStackLayout
                Spacing="5"
                Margin="0,40,0,30">

                <Label
                    Text="SMARTJOB"
                    TextColor="#E53935"
                    FontSize="36"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Technician Mobile"
                    TextColor="#BDBDBD"
                    FontSize="16"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Welcome -->
            <Label
                Text="Welcome back"
                TextColor="White"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Sign in to access your assigned jobs."
                TextColor="#BDBDBD"
                FontSize="14"
                Margin="0,0,0,10" />

            <!-- Email -->
            <Label
                Text="Email"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold" />

            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="15,4">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Entry
                    Text="{Binding Email}"
                    Placeholder="Enter your email"
                    PlaceholderColor="#757575"
                    TextColor="White"
                    Keyboard="Email"
                    ClearButtonVisibility="WhileEditing"
                    SemanticProperties.Description="Email address" />

            </Border>

            <!-- Password -->
            <Label
                Text="Password"
                TextColor="White"
                FontSize="14"
                FontAttributes="Bold" />

            <Border
                BackgroundColor="#1E1E1E"
                Stroke="#424242"
                StrokeThickness="1"
                Padding="15,4">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <Entry
                    Text="{Binding Password}"
                    Placeholder="Enter your password"
                    PlaceholderColor="#757575"
                    TextColor="White"
                    IsPassword="True"
                    ReturnType="Done"
                    SemanticProperties.Description="Password" />

            </Border>

            <!-- Login Button -->
            <Button
                Text="SIGN IN"
                Command="{Binding LoginCommand}"
                BackgroundColor="#E53935"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="52"
                CornerRadius="10"
                Margin="0,15,0,0"
                SemanticProperties.Description="Sign in to SmartJob" />

            <!-- Validation / Error Message -->
            <Label
                Text="{Binding ErrorMessage}"
                TextColor="#FF5252"
                FontSize="13"
                HorizontalTextAlignment="Center" />

            <!-- Connection Status -->
            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="7"
                Margin="0,15,0,0">

                <BoxView
                    Color="#4CAF50"
                    WidthRequest="9"
                    HeightRequest="9"
                    CornerRadius="5"
                    VerticalOptions="Center" />

                <Label
                    Text="Online"
                    TextColor="#BDBDBD"
                    FontSize="12"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <!-- Footer -->
            <Label
                Text="SmartJob Mobile"
                TextColor="#616161"
                FontSize="11"
                HorizontalTextAlignment="Center"
                Margin="0,20,0,20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
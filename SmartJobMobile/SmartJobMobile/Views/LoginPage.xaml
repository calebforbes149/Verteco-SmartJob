<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.LoginPage"
    BackgroundColor="#0A0C0F"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="26,30,26,32"
            Spacing="0">

            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="2"
                Margin="0,34,0,0"
                HorizontalOptions="Center">

                <Label
                    Text="VERTECO"
                    TextColor="#F2F2F2"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="2.6"
                    HorizontalTextAlignment="Center" />

                <HorizontalStackLayout
                    Spacing="5"
                    HorizontalOptions="Center">

                    <Label
                        Text="SMART"
                        TextColor="#FFFFFF"
                        FontSize="31"
                        FontAttributes="Bold" />

                    <Label
                        Text="JOB"
                        TextColor="#ED3B3B"
                        FontSize="31"
                        FontAttributes="Bold" />

                </HorizontalStackLayout>

                <Label
                    Text="TECHNICIAN MOBILE"
                    TextColor="#686E76"
                    FontSize="8"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- RED BRAND MARK -->
            <BoxView
                WidthRequest="36"
                HeightRequest="3"
                Color="#ED3B3B"
                HorizontalOptions="Center"
                Margin="0,20,0,0" />


            <!-- ================================================= -->
            <!-- LOGIN INTRO -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="5"
                Margin="0,48,0,0">

                <Label
                    Text="TECHNICIAN ACCESS"
                    TextColor="#ED3B3B"
                    FontSize="9"
                    FontAttributes="Bold"
                    CharacterSpacing="1.8" />

                <Label
                    Text="Welcome back"
                    TextColor="#FFFFFF"
                    FontSize="30"
                    FontAttributes="Bold"
                    SemanticProperties.HeadingLevel="Level1" />

                <Label
                    Text="Sign in to access your assigned jobs and field workflow."
                    TextColor="#7C828A"
                    FontSize="12"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>


            <!-- ================================================= -->
            <!-- LOGIN FORM -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#111419"
                Stroke="#292D33"
                StrokeThickness="1"
                Padding="20"
                Margin="0,28,0,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">

                    <!-- EMAIL -->
                    <Label
                        Text="EMAIL ADDRESS"
                        TextColor="#8D939A"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8" />

                    <Border
                        BackgroundColor="#171A1F"
                        Stroke="#30343A"
                        StrokeThickness="1"
                        Padding="5"
                        Margin="0,8,0,0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding Email}"
                            Placeholder="Enter your email"
                            PlaceholderColor="#5F656D"
                            TextColor="#E4E5E7"
                            Keyboard="Email"
                            ClearButtonVisibility="WhileEditing"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            MinimumHeightRequest="48"
                            FontSize="12"
                            SemanticProperties.Description="Email address" />

                    </Border>


                    <!-- PASSWORD -->
                    <Label
                        Text="PASSWORD"
                        TextColor="#8D939A"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8"
                        Margin="0,20,0,0" />

                    <Border
                        BackgroundColor="#171A1F"
                        Stroke="#30343A"
                        StrokeThickness="1"
                        Padding="5"
                        Margin="0,8,0,0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding Password}"
                            Placeholder="Enter your password"
                            PlaceholderColor="#5F656D"
                            TextColor="#E4E5E7"
                            IsPassword="True"
                            ReturnType="Done"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            MinimumHeightRequest="48"
                            FontSize="12"
                            SemanticProperties.Description="Password" />

                    </Border>


                    <!-- ERROR -->
                    <Border
                        BackgroundColor="#241416"
                        Stroke="#5A292D"
                        StrokeThickness="1"
                        Padding="12"
                        Margin="0,18,0,0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>

                        <Border.Triggers>

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding ErrorMessage}"
                                Value="">

                                <Setter
                                    Property="IsVisible"
                                    Value="False" />

                            </DataTrigger>

                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding ErrorMessage}"
                                Value="{x:Null}">

                                <Setter
                                    Property="IsVisible"
                                    Value="False" />

                            </DataTrigger>

                        </Border.Triggers>

                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="#EF7777"
                            FontSize="11"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                    </Border>


                    <!-- SIGN IN -->
                    <Button
                        Text="SIGN IN"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#ED3B3B"
                        TextColor="#FFFFFF"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        HeightRequest="52"
                        CornerRadius="6"
                        Margin="0,22,0,0"
                        SemanticProperties.Description="Sign in to SmartJob" />

                </VerticalStackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- FIELD ACCESS INFORMATION -->
            <!-- ================================================= -->

            <Border
                BackgroundColor="#0E1013"
                Stroke="#20242A"
                StrokeThickness="1"
                Padding="14"
                Margin="0,16,0,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>

                <Grid
                    ColumnDefinitions="3,*"
                    ColumnSpacing="12">

                    <BoxView
                        Grid.Column="0"
                        WidthRequest="3"
                        Color="#ED3B3B"
                        CornerRadius="2" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="3">

                        <Label
                            Text="FIELD OPERATIONS"
                            TextColor="#BFC3C8"
                            FontSize="9"
                            FontAttributes="Bold"
                            CharacterSpacing="0.8" />

                        <Label
                            Text="Secure access to assigned jobs, evidence capture and field workflow."
                            TextColor="#646A72"
                            FontSize="10"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <VerticalStackLayout
                Spacing="4"
                Margin="0,36,0,20">

                <BoxView
                    HeightRequest="1"
                    Color="#20242A"
                    Margin="0,0,0,12" />

                <Label
                    Text="VERTECO SMARTJOB"
                    TextColor="#50555C"
                    FontSize="8"
                    FontAttributes="Bold"
                    CharacterSpacing="1.5"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="TECHNICIAN MOBILE"
                    TextColor="#41464D"
                    FontSize="7"
                    CharacterSpacing="1.2"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.NotificationsPage"
    BackgroundColor="#0A0C0F"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,22,24,0"
            Spacing="0">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <!-- BACK -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#111419"
                    Stroke="#272B31"
                    StrokeThickness="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="BackButton_Clicked" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="‹"
                        TextColor="#B8BCC2"
                        FontSize="30"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-3,0,0"
                        SemanticProperties.Description="Go back" />

                </Border>

                <!-- BRAND -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="VERTECO"
                        TextColor="#F2F2F2"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2.2" />

                    <HorizontalStackLayout Spacing="4">

                        <Label
                            Text="SMART"
                            TextColor="#FFFFFF"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="JOB"
                            TextColor="#ED3B3B"
                            FontSize="20"
                            FontAttributes="Bold" />

                    </HorizontalStackLayout>

                    <Label
                        Text="TECHNICIAN CONSOLE"
                        TextColor="#686E76"
                        FontSize="7"
                        FontAttributes="Bold"
                        CharacterSpacing="1.6" />

                </VerticalStackLayout>

            </Grid>

            <BoxView
                HeightRequest="1"
                Color="#24282E"
                Margin="0,20,0,0" />

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="24,26,24,32"
                Spacing="0">

                <!-- PAGE INTRO -->
                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="ACTIVITY"
                        TextColor="#ED3B3B"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2" />

                    <Label
                        Text="Notifications"
                        TextColor="#FFFFFF"
                        FontSize="30"
                        FontAttributes="Bold"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="Job updates and important technician alerts."
                        TextColor="#7C828A"
                        FontSize="12"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- SUMMARY -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="0"
                    Margin="0,24,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="0">

                        <BoxView
                            HeightRequest="2"
                            Color="#ED3B3B" />

                        <Grid
                            Padding="18"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="14">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="NOTIFICATION CENTRE"
                                    TextColor="#646A72"
                                    FontSize="8"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1" />

                                <Label
                                    Text="{Binding Notifications.Count, StringFormat='{0} total notifications'}"
                                    TextColor="#FFFFFF"
                                    FontSize="17"
                                    FontAttributes="Bold" />

                            </VerticalStackLayout>

                        </Grid>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- LIST -->
                <!-- ================================================= -->

                <CollectionView
                    Margin="0,24,0,0"
                    ItemsSource="{Binding Notifications}">

                    <CollectionView.EmptyView>

                        <VerticalStackLayout
                            Spacing="0"
                            Padding="15,48,15,44">

                            <!-- BELL ICON -->
                            <Border
                                HeightRequest="82"
                                WidthRequest="82"
                                BackgroundColor="#111419"
                                Stroke="#292D33"
                                StrokeThickness="1"
                                HorizontalOptions="Center"
                                Padding="0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="41" />
                                </Border.StrokeShape>

                                <Path
                                    Data="M12,22 C13.1,22 14,21.1 14,20 L10,20 C10,21.1 10.9,22 12,22 Z
                                          M18,16 L18,11 C18,7.9 16.4,5.3 13.5,4.6
                                          L13.5,4 C13.5,3.2 12.8,2.5 12,2.5
                                          C11.2,2.5 10.5,3.2 10.5,4
                                          L10.5,4.6 C7.6,5.3 6,7.9 6,11
                                          L6,16 L4,18 L20,18 Z"
                                    Stroke="#ED3B3B"
                                    StrokeThickness="1.5"
                                    Fill="Transparent"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Aspect="Uniform"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="Notifications" />

                            </Border>


                            <Label
                                Text="NO NEW NOTIFICATIONS"
                                TextColor="#FFFFFF"
                                FontSize="16"
                                FontAttributes="Bold"
                                CharacterSpacing="0.5"
                                HorizontalTextAlignment="Center"
                                Margin="0,20,0,0" />

                            <Label
                                Text="You're all caught up. Important updates to your assigned work will appear here when available."
                                TextColor="#7C828A"
                                FontSize="11"
                                LineHeight="1.3"
                                HorizontalTextAlignment="Center"
                                LineBreakMode="WordWrap"
                                MaximumWidthRequest="440"
                                HorizontalOptions="Center"
                                Margin="0,8,0,0" />

                        </VerticalStackLayout>

                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                BackgroundColor="#111419"
                                Stroke="#292D33"
                                StrokeThickness="1"
                                Padding="16"
                                Margin="0,0,0,10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="Notification_Tapped" />
                                </Border.GestureRecognizers>

                                <Grid
                                    ColumnDefinitions="3,*"
                                    ColumnSpacing="12">

                                    <BoxView
                                        Grid.Column="0"
                                        Color="#ED3B3B"
                                        CornerRadius="2" />

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="4">

                                        <Label
                                            Text="{Binding Title}"
                                            TextColor="#FFFFFF"
                                            FontSize="14"
                                            FontAttributes="Bold" />

                                        <Label
                                            Text="{Binding Message}"
                                            TextColor="#9BA0A6"
                                            FontSize="12"
                                            LineBreakMode="WordWrap" />

                                        <Label
                                            Text="{Binding TimeAgo}"
                                            TextColor="#50555C"
                                            FontSize="10"
                                            Margin="0,4,0,0" />

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>


                <!-- ================================================= -->
                <!-- INFORMATION -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#0E1013"
                    Stroke="#20242A"
                    StrokeThickness="1"
                    Padding="15">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="3,*"
                        ColumnSpacing="12">

                        <BoxView
                            Grid.Column="0"
                            WidthRequest="3"
                            Color="#ED3B3B"
                            CornerRadius="2" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4">

                            <Label
                                Text="SMARTJOB UPDATES"
                                TextColor="#DADDE0"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="0.7" />

                            <Label
                                Text="Important changes to assigned work will be displayed here when notification data is available."
                                TextColor="#6F757D"
                                FontSize="10"
                                LineHeight="1.25"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <BoxView
                    HeightRequest="1"
                    Color="#20242A"
                    Margin="0,28,0,0" />

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,12,0,0">

                    <Label
                        Text="VERTECO SMARTJOB"
                        TextColor="#50555C"
                        FontSize="8"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5" />

                    <Label
                        Grid.Column="1"
                        Text="NOTIFICATIONS"
                        TextColor="#50555C"
                        FontSize="8"
                        CharacterSpacing="1.2" />

                </Grid>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
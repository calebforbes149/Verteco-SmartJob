<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.NotificationsPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="20,18"
            ColumnDefinitions="Auto,*"
            BackgroundColor="#181818">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="30"
                TextColor="White"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="45"
                Clicked="BackButton_Clicked"
                SemanticProperties.Description="Go back" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">

                <Label
                    Text="NOTIFICATIONS"
                    TextColor="#E53935"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Label
                    Text="Job updates and important alerts"
                    TextColor="#9E9E9E"
                    FontSize="12" />

            </VerticalStackLayout>

        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="20">

                <!-- SUMMARY -->
                <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Your Notifications"
                                TextColor="White"
                                FontSize="17"
                                FontAttributes="Bold" />

                            <Label
                                Text="No new notifications"
                                TextColor="#9E9E9E"
                                FontSize="12" />

                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="#252525"
                            Stroke="#424242"
                            StrokeThickness="1"
                            Padding="11,6"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15" />
                            </Border.StrokeShape>

                            <Label
                                Text="0"
                                TextColor="#BDBDBD"
                                FontAttributes="Bold"
                                FontSize="12" />

                        </Border>

                    </Grid>

                </Border>

                <!-- EMPTY STATE -->
                <VerticalStackLayout
                    Spacing="18"
                    Padding="15,55"
                    HorizontalOptions="Fill">

                    <Border
                        HeightRequest="90"
                        WidthRequest="90"
                        BackgroundColor="#1E1E1E"
                        Stroke="#383838"
                        StrokeThickness="1"
                        HorizontalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="45" />
                        </Border.StrokeShape>

                        <Label
                            Text="!"
                            TextColor="#E53935"
                            FontSize="38"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            SemanticProperties.Description="Notifications" />

                    </Border>

                    <Label
                        Text="NO NEW NOTIFICATIONS"
                        TextColor="White"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="You're all caught up. Job assignments, reopened jobs and other important updates will appear here when available."
                        TextColor="#9E9E9E"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="420"
                        HorizontalOptions="Center" />

                </VerticalStackLayout>

                <!-- INFORMATION -->
                <Border
                    BackgroundColor="#252525"
                    Stroke="#424242"
                    StrokeThickness="1"
                    Padding="14"
                    Margin="0,10,0,20">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Label
                        Text="SmartJob will keep you informed of important changes to your assigned work."
                        TextColor="#9E9E9E"
                        FontSize="12"
                        HorizontalTextAlignment="Center" />

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
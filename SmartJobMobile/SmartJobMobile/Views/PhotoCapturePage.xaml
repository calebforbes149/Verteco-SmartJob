<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.PhotoCapturePage"
    BackgroundColor="#0A0C0F"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,22,24,0"
            Spacing="0">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <!-- BACK -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#111419"
                    Stroke="#272B31"
                    StrokeThickness="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="BackButton_Clicked" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="‹"
                        TextColor="#B8BCC2"
                        FontSize="30"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-3,0,0"
                        SemanticProperties.Description="Go back" />

                </Border>


                <!-- BRAND -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="VERTECO"
                        TextColor="#F2F2F2"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2.2" />

                    <HorizontalStackLayout Spacing="4">

                        <Label
                            Text="SMART"
                            TextColor="#FFFFFF"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="JOB"
                            TextColor="#ED3B3B"
                            FontSize="20"
                            FontAttributes="Bold" />

                    </HorizontalStackLayout>

                    <Label
                        Text="TECHNICIAN CONSOLE"
                        TextColor="#686E76"
                        FontSize="7"
                        FontAttributes="Bold"
                        CharacterSpacing="1.6" />

                </VerticalStackLayout>

            </Grid>

            <BoxView
                HeightRequest="1"
                Color="#24282E"
                Margin="0,20,0,0" />

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="24,26,24,32"
                Spacing="0">


                <!-- PAGE INTRO -->
                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="FIELD WORKFLOW"
                        TextColor="#ED3B3B"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2" />

                    <Label
                        Text="Photo Evidence"
                        TextColor="#FFFFFF"
                        FontSize="30"
                        FontAttributes="Bold"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="Capture clear photographic evidence for this job."
                        TextColor="#7C828A"
                        FontSize="12" />

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- JOB INFORMATION -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="0"
                    Margin="0,24,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="0">

                        <BoxView
                            HeightRequest="2"
                            Color="#ED3B3B" />

                        <VerticalStackLayout
                            Padding="18"
                            Spacing="0">

                            <Label
                                Text="CURRENT JOB"
                                TextColor="#646A72"
                                FontSize="8"
                                FontAttributes="Bold"
                                CharacterSpacing="1.4" />

                            <Label
                                Text="{Binding JobNumber}"
                                TextColor="#ED3B3B"
                                FontSize="12"
                                FontAttributes="Bold"
                                Margin="0,4,0,0" />

                            <Label
                                Text="{Binding JobTitle}"
                                TextColor="#FFFFFF"
                                FontSize="19"
                                FontAttributes="Bold"
                                Margin="0,9,0,0"
                                LineBreakMode="WordWrap" />

                            <Label
                                Text="{Binding JobLocation}"
                                TextColor="#7C828A"
                                FontSize="11"
                                Margin="0,5,0,0"
                                LineBreakMode="WordWrap" />

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>


                <!-- ================================================= -->
                <!-- EVIDENCE SECTION -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    IsVisible="{Binding HasSavedEvidence}"
                    Spacing="10"
                    Margin="0,24,0,20">
                    <Label
                        Text="SAVED JOB PHOTOS"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold" />
                    <Label
                        Text="These photos stay on the job card. Edit a description, remove a photo, or add another below."
                        TextColor="#858B93"
                        FontSize="11"
                        LineBreakMode="WordWrap" />
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding SavedEvidence}"
                        Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    BackgroundColor="#111419"
                                    Stroke="#292D33"
                                    StrokeThickness="1"
                                    Padding="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Image
                                            Source="{Binding Preview}"
                                            HeightRequest="180"
                                            Aspect="AspectFit" />
                                        <Entry
                                            Text="{Binding Caption, Mode=TwoWay}"
                                            Placeholder="Photo description"
                                            TextColor="#E4E5E7"
                                            BackgroundColor="#171A1F" />
                                        <Button
                                            Text="SAVE DESCRIPTION"
                                            CommandParameter="{Binding Id}"
                                            Clicked="SaveEvidenceCaption_Clicked"
                                            BackgroundColor="#171A1F"
                                            TextColor="#E4E5E7" />
                                        <Button
                                            Text="REMOVE SAVED PHOTO"
                                            CommandParameter="{Binding Id}"
                                            Clicked="RemoveSavedEvidence_Clicked"
                                            BackgroundColor="Transparent"
                                            TextColor="#ED6464" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,28,0,12">

                    <Label
                        Text="JOB EVIDENCE"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5" />

                    <Label
                        Text="Take a photo or select an existing image from the device."
                        TextColor="#646A72"
                        FontSize="10" />

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- PHOTO PREVIEW -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    HeightRequest="280"
                    Padding="8">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid>

                        <!-- EMPTY STATE -->
                        <VerticalStackLayout
                            IsVisible="{Binding HasNoPhoto}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="8"
                            Padding="20">

                            <!-- SIMPLE CAMERA SYMBOL -->
                            <Border
                                WidthRequest="58"
                                HeightRequest="58"
                                BackgroundColor="#171A1F"
                                Stroke="#30343A"
                                StrokeThickness="1"
                                Padding="14"
                                HorizontalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <Path
                                    Data="M9,4 L11,2 L17,2 L19,4 L22,4 C23.1,4 24,4.9 24,6 L24,19 C24,20.1 23.1,21 22,21 L2,21 C0.9,21 0,20.1 0,19 L0,6 C0,4.9 0.9,4 2,4 Z M12,7 C8.7,7 6,9.7 6,13 C6,16.3 8.7,19 12,19 C15.3,19 18,16.3 18,13 C18,9.7 15.3,7 12,7 Z M12,9 C14.2,9 16,10.8 16,13 C16,15.2 14.2,17 12,17 C9.8,17 8,15.2 8,13 C8,10.8 9.8,9 12,9 Z"
                                    Fill="#737981"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Aspect="Uniform"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <Label
                                Text="NO PHOTO ADDED"
                                TextColor="#D4D6D9"
                                FontSize="11"
                                FontAttributes="Bold"
                                CharacterSpacing="0.8"
                                HorizontalTextAlignment="Center"
                                Margin="0,5,0,0" />

                            <Label
                                Text="Capture or choose a photo below"
                                TextColor="#646A72"
                                FontSize="10"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>


                        <!-- SELECTED PHOTO -->
                        <Image
                            Source="{Binding PhotoSource}"
                            IsVisible="{Binding HasPhoto}"
                            Aspect="AspectFit"
                            Margin="4"
                            SemanticProperties.Description="Selected job evidence photo" />

                    </Grid>

                </Border>


                <!-- PHOTO STATUS -->
                <Border
                    IsVisible="{Binding HasPhoto}"
                    BackgroundColor="#111916"
                    Stroke="#263C2E"
                    StrokeThickness="1"
                    Padding="12"
                    Margin="0,10,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding PhotoStatus}"
                        TextColor="#73B986"
                        FontSize="10"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                </Border>


                <!-- ================================================= -->
                <!-- PHOTO ACTIONS -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="10"
                    Margin="0,18,0,0">

                    <Button
                        Text="TAKE PHOTO"
                        Command="{Binding TakePhotoCommand}"
                        BackgroundColor="#ED3B3B"
                        TextColor="#FFFFFF"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8"
                        HeightRequest="52"
                        CornerRadius="6"
                        SemanticProperties.Description="Take a photo using the device camera" />

                    <Button
                        Text="CHOOSE PHOTO FROM DEVICE"
                        Command="{Binding ChoosePhotoCommand}"
                        BackgroundColor="#111419"
                        TextColor="#DADDE0"
                        BorderColor="#34383E"
                        BorderWidth="1"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5"
                        HeightRequest="50"
                        CornerRadius="6"
                        SemanticProperties.Description="Choose an existing photo from this device" />

                    <Button
                        Text="REMOVE PHOTO"
                        Command="{Binding RemovePhotoCommand}"
                        IsVisible="{Binding HasPhoto}"
                        BackgroundColor="Transparent"
                        TextColor="#ED6464"
                        BorderColor="#5B292D"
                        BorderWidth="1"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5"
                        HeightRequest="48"
                        CornerRadius="6"
                        SemanticProperties.Description="Remove selected evidence photo" />

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- PHOTO NOTES -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,28,0,12">

                    <Label
                        Text="PHOTO NOTES"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5" />

                    <Label
                        Text="Optional description or visible issues"
                        TextColor="#646A72"
                        FontSize="10" />

                </VerticalStackLayout>


                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Editor
                        Text="{Binding PhotoNotes}"
                        Placeholder="Describe the photo or any visible issues..."
                        PlaceholderColor="#5F656D"
                        TextColor="#E4E5E7"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="100"
                        FontSize="12"
                        SemanticProperties.Description="Notes describing the evidence photo" />

                </Border>


                <!-- ================================================= -->
                <Label
                    Text="The photographic evidence check is marked complete when your photo is saved."
                    TextColor="#858B93"
                    FontSize="11"
                    Margin="0,22,0,0"
                    LineBreakMode="WordWrap" />

                <!-- ERROR -->
                <!-- ================================================= -->

                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#241416"
                    Stroke="#5A292D"
                    StrokeThickness="1"
                    Padding="14"
                    Margin="0,18,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="#EF7777"
                        FontSize="11"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                </Border>


                <!-- ================================================= -->
                <!-- CONTINUE -->
                <!-- ================================================= -->

                <Button
                    Text="SAVE EVIDENCE &amp; CONTINUE"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanContinue}"
                    BackgroundColor="#ED3B3B"
                    TextColor="#FFFFFF"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    HeightRequest="52"
                    CornerRadius="6"
                    Margin="0,28,0,0"
                    SemanticProperties.Description="Save photo evidence and continue" />


                <!-- FOOTER -->
                <BoxView
                    HeightRequest="1"
                    Color="#20242A"
                    Margin="0,28,0,0" />

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,12,0,0">

                    <Label
                        Text="VERTECO SMARTJOB"
                        TextColor="#50555C"
                        FontSize="8"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5" />

                    <Label
                        Grid.Column="1"
                        Text="PHOTO EVIDENCE"
                        TextColor="#50555C"
                        FontSize="8"
                        CharacterSpacing="1.2" />

                </Grid>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
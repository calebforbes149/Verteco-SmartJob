<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.EquipmentPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="20,18"
            ColumnDefinitions="Auto,*"
            BackgroundColor="#181818">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="30"
                TextColor="White"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="45"
                Clicked="BackButton_Clicked"
                SemanticProperties.Description="Go back" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">

                <Label
                    Text="EQUIPMENT DETAILS"
                    TextColor="#E53935"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Label
                    Text="Record equipment and serial information"
                    TextColor="#9E9E9E"
                    FontSize="12" />

            </VerticalStackLayout>

        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <!-- JOB INFORMATION -->
                <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="JOB-1001"
                            TextColor="#E53935"
                            FontSize="13"
                            FontAttributes="Bold" />

                        <Label
                            Text="Equipment Inspection"
                            TextColor="White"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="Verteco Client Site"
                            TextColor="#BDBDBD"
                            FontSize="13" />

                    </VerticalStackLayout>

                </Border>

                <!-- SECTION TITLE -->
                <Label
                    Text="Equipment Information"
                    TextColor="White"
                    FontSize="17"
                    FontAttributes="Bold" />

                <!-- EQUIPMENT NAME -->
                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="Equipment Name / Type *"
                        TextColor="#BDBDBD"
                        FontSize="13" />

                    <Border
                        BackgroundColor="#1E1E1E"
                        Stroke="#424242"
                        StrokeThickness="1"
                        Padding="5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding EquipmentName}"
                            Placeholder="e.g. Industrial Pump"
                            PlaceholderColor="#757575"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            SemanticProperties.Description="Equipment name or type" />

                    </Border>

                </VerticalStackLayout>

                <!-- SERIAL NUMBER -->
                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="Serial Number *"
                        TextColor="#BDBDBD"
                        FontSize="13" />

                    <Border
                        BackgroundColor="#1E1E1E"
                        Stroke="#424242"
                        StrokeThickness="1"
                        Padding="5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding SerialNumber}"
                            Placeholder="Enter serial number"
                            PlaceholderColor="#757575"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            SemanticProperties.Description="Equipment serial number" />

                    </Border>

                </VerticalStackLayout>

                <!-- ASSET NUMBER -->
                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="Asset Number"
                        TextColor="#BDBDBD"
                        FontSize="13" />

                    <Border
                        BackgroundColor="#1E1E1E"
                        Stroke="#424242"
                        StrokeThickness="1"
                        Padding="5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding AssetNumber}"
                            Placeholder="Enter asset number"
                            PlaceholderColor="#757575"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            SemanticProperties.Description="Equipment asset number" />

                    </Border>

                </VerticalStackLayout>

                <!-- MODEL NUMBER -->
                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="Model Number"
                        TextColor="#BDBDBD"
                        FontSize="13" />

                    <Border
                        BackgroundColor="#1E1E1E"
                        Stroke="#424242"
                        StrokeThickness="1"
                        Padding="5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding ModelNumber}"
                            Placeholder="Enter model number"
                            PlaceholderColor="#757575"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            SemanticProperties.Description="Equipment model number" />

                    </Border>

                </VerticalStackLayout>

                <!-- NOTES -->
                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="Equipment Notes"
                        TextColor="#BDBDBD"
                        FontSize="13" />

                    <Border
                        BackgroundColor="#1E1E1E"
                        Stroke="#424242"
                        StrokeThickness="1"
                        Padding="10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Editor
                            Text="{Binding EquipmentNotes}"
                            Placeholder="Add any additional equipment information..."
                            PlaceholderColor="#757575"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="100"
                            SemanticProperties.Description="Additional equipment notes" />

                    </Border>

                </VerticalStackLayout>

                <!-- ERROR MESSAGE -->
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#EF5350"
                    FontSize="13"
                    IsVisible="{Binding HasError}" />

                <!-- CONTINUE -->
                <Button
                    Text="CONTINUE"
                    Command="{Binding ContinueCommand}"
                    BackgroundColor="#E53935"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="10"
                    Margin="0,10,0,20"
                    SemanticProperties.Description="Save equipment details and continue" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
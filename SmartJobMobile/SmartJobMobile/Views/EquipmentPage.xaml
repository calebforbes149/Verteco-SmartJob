<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.EquipmentPage"
    BackgroundColor="#0A0C0F"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Padding="24,22,24,0"
            Spacing="0">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <!-- BACK -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="#111419"
                    Stroke="#272B31"
                    StrokeThickness="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    VerticalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="BackButton_Clicked" />
                    </Border.GestureRecognizers>

                    <Label
                        Text="‹"
                        TextColor="#B8BCC2"
                        FontSize="30"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-3,0,0"
                        SemanticProperties.Description="Go back" />

                </Border>


                <!-- BRAND -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="VERTECO"
                        TextColor="#F2F2F2"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2.2" />

                    <HorizontalStackLayout Spacing="4">

                        <Label
                            Text="SMART"
                            TextColor="#FFFFFF"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <Label
                            Text="JOB"
                            TextColor="#ED3B3B"
                            FontSize="20"
                            FontAttributes="Bold" />

                    </HorizontalStackLayout>

                    <Label
                        Text="TECHNICIAN CONSOLE"
                        TextColor="#686E76"
                        FontSize="7"
                        FontAttributes="Bold"
                        CharacterSpacing="1.6" />

                </VerticalStackLayout>

            </Grid>


            <BoxView
                HeightRequest="1"
                Color="#24282E"
                Margin="0,20,0,0" />

        </VerticalStackLayout>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="24,26,24,32"
                Spacing="0">


                <!-- PAGE INTRODUCTION -->
                <VerticalStackLayout Spacing="5">

                    <Label
                        Text="FIELD WORKFLOW"
                        TextColor="#ED3B3B"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="2" />

                    <Label
                        Text="Equipment Details"
                        TextColor="#FFFFFF"
                        FontSize="30"
                        FontAttributes="Bold"
                        SemanticProperties.HeadingLevel="Level1" />

                    <Label
                        Text="Record equipment identification and asset information."
                        TextColor="#7C828A"
                        FontSize="12" />

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- WORKFLOW STATUS -->
                <!-- ================================================= -->

                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="18"
                    Margin="0,24,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="3,*"
                        ColumnSpacing="14">

                        <BoxView
                            Grid.Column="0"
                            WidthRequest="3"
                            Color="#ED3B3B"
                            CornerRadius="2"
                            HorizontalOptions="Start" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="EQUIPMENT RECORD"
                                TextColor="#DADDE0"
                                FontSize="9"
                                FontAttributes="Bold"
                                CharacterSpacing="1" />

                            <Label
                                Text="Enter the identifying information for the equipment associated with this job."
                                TextColor="#7C828A"
                                FontSize="11"
                                LineHeight="1.3" />

                            <Label
                                Text="* Required field"
                                TextColor="#ED3B3B"
                                FontSize="9"
                                Margin="0,3,0,0" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>


                <VerticalStackLayout
                    x:Name="SafetyChecklistHost"
                    Margin="0,24,0,0" />


                <!-- ================================================= -->
                <!-- EQUIPMENT INFORMATION -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,28,0,14">

                    <Label
                        Text="EQUIPMENT INFORMATION"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5" />

                    <Label
                        Text="Asset identification details"
                        TextColor="#646A72"
                        FontSize="10" />

                </VerticalStackLayout>


                <!-- EQUIPMENT NAME -->
                <VerticalStackLayout
                    IsVisible="{Binding HasSiteEquipmentOptions}"
                    Spacing="6"
                    Margin="0,0,0,16">
                    <Label
                        Text="PREVIOUSLY RECORDED AT THIS SITE"
                        TextColor="#8D939A"
                        FontSize="10"
                        FontAttributes="Bold" />
                    <Picker
                        Title="Select existing equipment instead of re-entering it"
                        ItemsSource="{Binding SiteEquipmentOptions}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedSiteEquipment}"
                        TextColor="#E4E5E7"
                        BackgroundColor="#171A1F" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">

                    <Label
                        Text="EQUIPMENT NAME / TYPE *"
                        TextColor="#8D939A"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8" />

                    <Border
                        BackgroundColor="#111419"
                        Stroke="#292D33"
                        StrokeThickness="1"
                        Padding="5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding EquipmentName}"
                            Placeholder="e.g. Industrial Pump"
                            PlaceholderColor="#5F656D"
                            TextColor="#E4E5E7"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            MinimumHeightRequest="48"
                            FontSize="12"
                            SemanticProperties.Description="Equipment name or type" />

                    </Border>

                </VerticalStackLayout>


                <!-- SERIAL NUMBER -->
                <VerticalStackLayout
                    Spacing="7"
                    Margin="0,18,0,0">

                    <Label
                        Text="SERIAL NUMBER *"
                        TextColor="#8D939A"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8" />

                    <Border
                        BackgroundColor="#111419"
                        Stroke="#292D33"
                        StrokeThickness="1"
                        Padding="5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding SerialNumber}"
                            Placeholder="Enter serial number"
                            PlaceholderColor="#5F656D"
                            TextColor="#E4E5E7"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            MinimumHeightRequest="48"
                            FontSize="12"
                            SemanticProperties.Description="Equipment serial number" />

                    </Border>

                </VerticalStackLayout>


                <!-- ASSET NUMBER -->
                <VerticalStackLayout
                    Spacing="7"
                    Margin="0,18,0,0">

                    <Label
                        Text="ASSET NUMBER"
                        TextColor="#8D939A"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8" />

                    <Border
                        BackgroundColor="#111419"
                        Stroke="#292D33"
                        StrokeThickness="1"
                        Padding="5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding AssetNumber}"
                            Placeholder="Enter asset number"
                            PlaceholderColor="#5F656D"
                            TextColor="#E4E5E7"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            MinimumHeightRequest="48"
                            FontSize="12"
                            SemanticProperties.Description="Equipment asset number" />

                    </Border>

                </VerticalStackLayout>


                <!-- MODEL NUMBER -->
                <VerticalStackLayout
                    Spacing="7"
                    Margin="0,18,0,0">

                    <Label
                        Text="MODEL NUMBER"
                        TextColor="#8D939A"
                        FontSize="9"
                        FontAttributes="Bold"
                        CharacterSpacing="0.8" />

                    <Border
                        BackgroundColor="#111419"
                        Stroke="#292D33"
                        StrokeThickness="1"
                        Padding="5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>

                        <Entry
                            Text="{Binding ModelNumber}"
                            Placeholder="Enter model number"
                            PlaceholderColor="#5F656D"
                            TextColor="#E4E5E7"
                            BackgroundColor="Transparent"
                            Margin="8,0"
                            MinimumHeightRequest="48"
                            FontSize="12"
                            SemanticProperties.Description="Equipment model number" />

                    </Border>

                </VerticalStackLayout>


                <!-- ================================================= -->
                <!-- EQUIPMENT DETAILS CHECK -->
                <VerticalStackLayout
                    x:Name="EquipmentChecklistHost"
                    Margin="0,24,0,0" />

                <!-- EQUIPMENT NOTES -->
                <!-- ================================================= -->

                <VerticalStackLayout
                    Spacing="2"
                    Margin="0,28,0,12">

                    <Label
                        Text="EQUIPMENT NOTES"
                        TextColor="#FFFFFF"
                        FontSize="14"
                        FontAttributes="Bold"
                        CharacterSpacing="0.5" />

                    <Label
                        Text="Optional observations or identifying information"
                        TextColor="#646A72"
                        FontSize="10" />

                </VerticalStackLayout>


                <Border
                    BackgroundColor="#111419"
                    Stroke="#292D33"
                    StrokeThickness="1"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Editor
                        Text="{Binding EquipmentNotes}"
                        Placeholder="Add any additional equipment information..."
                        PlaceholderColor="#5F656D"
                        TextColor="#E4E5E7"
                        BackgroundColor="Transparent"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="105"
                        FontSize="12"
                        SemanticProperties.Description="Additional equipment notes" />

                </Border>


                <!-- ================================================= -->
                <!-- WORK COMPLETION CHECK -->
                <VerticalStackLayout
                    x:Name="WorkChecklistHost"
                    Margin="0,24,0,0" />

                <!-- EQUIPMENT SAVE STATUS -->
                <Border
                    IsVisible="{Binding IsEquipmentUploaded}"
                    BackgroundColor="#111916"
                    Stroke="#263C2E"
                    StrokeThickness="1"
                    Padding="12"
                    Margin="0,20,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Label
                        Text="✓ SAVED TO JOB CARD"
                        TextColor="#73B986"
                        FontSize="10"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                </Border>

                <Border
                    IsVisible="{Binding IsEquipmentPendingSync}"
                    BackgroundColor="#1C1710"
                    Stroke="#4A3A1A"
                    StrokeThickness="1"
                    Padding="12"
                    Margin="0,20,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="⏳ SAVED ON THIS DEVICE — NOT YET UPLOADED"
                            TextColor="#E0A030"
                            FontSize="10"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="This equipment will upload to SmartJob the next time you sync."
                            TextColor="#B59354"
                            FontSize="9"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

                <Button
                    Text="REMOVE SAVED EQUIPMENT FROM THIS JOB"
                    Command="{Binding RemoveEquipmentCommand}"
                    IsVisible="{Binding HasSavedEquipment}"
                    BackgroundColor="Transparent"
                    TextColor="#ED6464"
                    BorderColor="#5B292D"
                    BorderWidth="1"
                    HeightRequest="48"
                    CornerRadius="6"
                    Margin="0,18,0,0" />

                <!-- ERROR -->
                <!-- ================================================= -->

                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#241416"
                    Stroke="#5A292D"
                    StrokeThickness="1"
                    Padding="14"
                    Margin="0,18,0,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="#EF7777"
                        FontSize="11"
                        LineBreakMode="WordWrap" />

                </Border>


                <!-- ================================================= -->
                <!-- CONTINUE -->
                <!-- ================================================= -->

                <Button
                    Text="SAVE &amp; CONTINUE"
                    Command="{Binding ContinueCommand}"
                    IsEnabled="{Binding CanContinue}"
                    BackgroundColor="#ED3B3B"
                    TextColor="#FFFFFF"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="0.8"
                    HeightRequest="52"
                    CornerRadius="6"
                    Margin="0,28,0,0"
                    SemanticProperties.Description="Save equipment details and continue" />


                <!-- FOOTER -->
                <BoxView
                    HeightRequest="1"
                    Color="#20242A"
                    Margin="0,28,0,0" />


                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,12,0,0">

                    <Label
                        Text="VERTECO SMARTJOB"
                        TextColor="#50555C"
                        FontSize="8"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5" />

                    <Label
                        Grid.Column="1"
                        Text="EQUIPMENT"
                        TextColor="#50555C"
                        FontSize="8"
                        CharacterSpacing="1.2" />

                </Grid>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
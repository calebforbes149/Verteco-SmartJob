<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.ReviewSubmitPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="20,18"
            ColumnDefinitions="Auto,*"
            BackgroundColor="#181818">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="30"
                TextColor="White"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="45"
                Clicked="BackButton_Clicked"
                SemanticProperties.Description="Go back" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">

                <Label
                    Text="REVIEW &amp; SUBMIT"
                    TextColor="#E53935"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Label
                    Text="Final review before submission"
                    TextColor="#9E9E9E"
                    FontSize="12" />

            </VerticalStackLayout>

        </Grid>

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <!-- JOB INFORMATION -->
                <Label
                    Text="Job Information"
                    TextColor="White"
                    FontSize="17"
                    FontAttributes="Bold" />

                <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="{Binding JobNumber}"
                            TextColor="#E53935"
                            FontSize="13"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding JobTitle}"
                            TextColor="White"
                            FontSize="20"
                            FontAttributes="Bold" />

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#383838"
                            Margin="0,5" />

                        <Grid
                            ColumnDefinitions="110,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="8">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Customer"
                                TextColor="#757575"
                                FontSize="13" />

                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="{Binding CustomerName}"
                                TextColor="#BDBDBD"
                                FontSize="13" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Location"
                                TextColor="#757575"
                                FontSize="13" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding JobLocation}"
                                TextColor="#BDBDBD"
                                FontSize="13" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Priority"
                                TextColor="#757575"
                                FontSize="13" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="{Binding Priority}"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold" />

                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="Scheduled"
                                TextColor="#757575"
                                FontSize="13" />

                            <Label
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="{Binding ScheduledDate}"
                                TextColor="#BDBDBD"
                                FontSize="13" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- COMPLETION SUMMARY -->
                <Label
                    Text="Completion Summary"
                    TextColor="White"
                    FontSize="17"
                    FontAttributes="Bold" />

                <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">

                        <!-- CHECKLIST -->
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="✓"
                                TextColor="#66BB6A"
                                FontSize="18"
                                FontAttributes="Bold"
                                Margin="0,0,10,0" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Checklist"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="Job checklist reviewed"
                                    TextColor="#757575"
                                    FontSize="12" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="COMPLETE"
                                TextColor="#66BB6A"
                                FontSize="11"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#383838" />

                        <!-- EQUIPMENT -->
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="✓"
                                TextColor="#66BB6A"
                                FontSize="18"
                                FontAttributes="Bold"
                                Margin="0,0,10,0" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Equipment"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="Equipment information recorded"
                                    TextColor="#757575"
                                    FontSize="12" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="ADDED"
                                TextColor="#66BB6A"
                                FontSize="11"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#383838" />

                        <!-- EVIDENCE -->
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="✓"
                                TextColor="#66BB6A"
                                FontSize="18"
                                FontAttributes="Bold"
                                Margin="0,0,10,0" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Photo Evidence"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="Job evidence uploaded"
                                    TextColor="#757575"
                                    FontSize="12" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="ADDED"
                                TextColor="#66BB6A"
                                FontSize="11"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            BackgroundColor="#383838" />

                        <!-- SIGNATURES -->
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="✓"
                                TextColor="#66BB6A"
                                FontSize="18"
                                FontAttributes="Bold"
                                Margin="0,0,10,0" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Signatures"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="Technician and client signatures recorded"
                                    TextColor="#757575"
                                    FontSize="12" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="CONFIRMED"
                                TextColor="#66BB6A"
                                FontSize="11"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- READY NOTICE -->
                <Border
                    BackgroundColor="#263D2A"
                    Stroke="#4CAF50"
                    StrokeThickness="1"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="✓ Ready for submission"
                            TextColor="#66BB6A"
                            FontSize="14"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="The job has reached the final review stage."
                            TextColor="#BDBDBD"
                            FontSize="12"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

                <!-- FINAL CONFIRMATION -->
                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="10"
                    Margin="0,5,0,0">

                    <CheckBox
                        IsChecked="{Binding IsSubmissionConfirmed}"
                        Color="#E53935"
                        VerticalOptions="Start"
                        SemanticProperties.Description="Confirm job is ready for submission" />

                    <Label
                        Grid.Column="1"
                        Text="I have reviewed the job information and confirm that the completed work is ready to be submitted for review."
                        TextColor="#BDBDBD"
                        FontSize="13"
                        VerticalOptions="Center" />

                </Grid>

                <!-- ERROR -->
                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#3D2424"
                    Stroke="#E53935"
                    StrokeThickness="1"
                    Padding="12">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="#EF5350"
                        FontSize="13"
                        HorizontalTextAlignment="Center" />

                </Border>

                <!-- SUBMIT -->
                <Button
                    Text="{Binding SubmitButtonText}"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    BackgroundColor="#E53935"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    HeightRequest="54"
                    CornerRadius="10"
                    Margin="0,10,0,20"
                    SemanticProperties.Description="Submit completed job for review" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>
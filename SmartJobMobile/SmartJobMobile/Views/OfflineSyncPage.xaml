<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SmartJobMobile.Views.OfflineSyncPage"
    BackgroundColor="#121212"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="20,18"
            ColumnDefinitions="Auto,*"
            BackgroundColor="#181818">

            <Button
                Grid.Column="0"
                Text="‹"
                FontSize="30"
                TextColor="White"
                BackgroundColor="Transparent"
                Padding="0"
                WidthRequest="45"
                Clicked="BackButton_Clicked"
                SemanticProperties.Description="Go back" />

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">

                <Label
                    Text="OFFLINE SYNC"
                    TextColor="#E53935"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Label
                    Text="Manage offline data and synchronisation"
                    TextColor="#9E9E9E"
                    FontSize="12" />

            </VerticalStackLayout>

        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="18">

                <!-- CONNECTION STATUS -->
                <Label
                    Text="CONNECTION STATUS"
                    TextColor="#BDBDBD"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1" />

                <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <BoxView
                            Grid.Column="0"
                            Color="{Binding ConnectionColor}"
                            WidthRequest="12"
                            HeightRequest="12"
                            CornerRadius="6"
                            VerticalOptions="Center"
                            Margin="0,0,12,0" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="{Binding ConnectionStatus}"
                                TextColor="White"
                                FontSize="17"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding ConnectionMessage}"
                                TextColor="#9E9E9E"
                                FontSize="12" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="{Binding ConnectionIcon}"
                            FontSize="22"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <!-- SYNC STATUS -->
                <Label
                    Text="SYNCHRONISATION"
                    TextColor="#BDBDBD"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1" />

                <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="Sync Status"
                                    TextColor="#9E9E9E"
                                    FontSize="12" />

                                <Label
                                    Text="{Binding SyncStatus}"
                                    TextColor="{Binding SyncStatusColor}"
                                    FontSize="16"
                                    FontAttributes="Bold" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="↻"
                                TextColor="#E53935"
                                FontSize="28"
                                VerticalOptions="Center" />

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#333333" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Last successful sync"
                                TextColor="#9E9E9E"
                                FontSize="13" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding LastSync}"
                                TextColor="White"
                                FontSize="13" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- PENDING OPERATIONS -->
                <Label
                    Text="OFFLINE QUEUE"
                    TextColor="#BDBDBD"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1" />

                <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="15">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="Pending Operations"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="Changes waiting to be sent to SmartJob"
                                    TextColor="#9E9E9E"
                                    FontSize="12" />

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#3D2424"
                                Stroke="#E53935"
                                StrokeThickness="1"
                                Padding="10,5"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="15" />
                                </Border.StrokeShape>

                                <Label
                                    Text="{Binding PendingOperations}"
                                    TextColor="#EF5350"
                                    FontSize="13"
                                    FontAttributes="Bold" />

                            </Border>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#333333" />

                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="📋"
                                FontSize="20"
                                VerticalOptions="Center"
                                Margin="0,0,10,0" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Job updates"
                                    TextColor="#BDBDBD"
                                    FontSize="13" />

                                <Label
                                    Text="Completed work waiting to sync"
                                    TextColor="#757575"
                                    FontSize="11" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="{Binding PendingJobUpdates}"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="📷"
                                FontSize="20"
                                VerticalOptions="Center"
                                Margin="0,0,10,0" />

                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">

                                <Label
                                    Text="Evidence uploads"
                                    TextColor="#BDBDBD"
                                    FontSize="13" />

                                <Label
                                    Text="Photos waiting to upload"
                                    TextColor="#757575"
                                    FontSize="11" />

                            </VerticalStackLayout>

                            <Label
                                Grid.Column="2"
                                Text="{Binding PendingEvidence}"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- CONFLICTS -->
                <Label
                    Text="CONFLICTS"
                    TextColor="#BDBDBD"
                    FontSize="12"
                    FontAttributes="Bold"
                    CharacterSpacing="1" />

                <Border
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    Padding="18">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <Label
                            Grid.Column="0"
                            Text="⚠"
                            TextColor="#FFC107"
                            FontSize="23"
                            VerticalOptions="Center"
                            Margin="0,0,12,0" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="3">

                            <Label
                                Text="Needs Review"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold" />

                            <Label
                                Text="Sync conflicts requiring attention"
                                TextColor="#9E9E9E"
                                FontSize="12" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="{Binding ConflictCount}"
                            TextColor="#FFC107"
                            FontSize="20"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <!-- SYNC INFORMATION -->
                <Border
                    BackgroundColor="#252525"
                    Stroke="#424242"
                    StrokeThickness="1"
                    Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Offline Mode"
                            TextColor="#E53935"
                            FontSize="14"
                            FontAttributes="Bold" />

                        <Label
                            Text="SmartJob can store job changes on this device while offline. Pending changes will synchronise when a connection becomes available."
                            TextColor="#BDBDBD"
                            FontSize="12" />

                    </VerticalStackLayout>

                </Border>

                <!-- ERROR -->
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#EF5350"
                    FontSize="13"
                    IsVisible="{Binding HasError}"
                    HorizontalTextAlignment="Center" />

                <!-- SYNC BUTTON -->
                <Button
                    Text="{Binding SyncButtonText}"
                    Command="{Binding SyncCommand}"
                    BackgroundColor="#E53935"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    CornerRadius="10"
                    IsEnabled="{Binding CanSync}"
                    SemanticProperties.Description="Synchronise offline SmartJob data" />

                <!-- REFRESH -->
                <Button
                    Text="REFRESH STATUS"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="#1E1E1E"
                    BorderColor="#555555"
                    BorderWidth="1"
                    TextColor="White"
                    FontSize="13"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    CornerRadius="10"
                    Margin="0,0,0,20"
                    SemanticProperties.Description="Refresh connection and synchronisation status" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>